2026-11-02T16:31:14.0491138Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T16:31:14.0491592Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T16:31:14.0491891Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T16:31:14.0492110Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T16:31:14.0492305Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T16:31:14.0492482Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T16:31:14.0492666Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T16:31:14.0492838Z try {
2026-11-02T16:31:14.0492953Z   Set-Location "${drive}:\"
2026-11-02T16:31:14.0493184Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T16:31:14.0493518Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T16:31:14.0493770Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T16:31:14.0493957Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:31:14.0494168Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T16:31:14.0494416Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T16:31:14.0494729Z   }
2026-11-02T16:31:14.0495000Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T16:31:14.0495458Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T16:31:14.0495815Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T16:31:14.0496046Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T16:31:14.0496274Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T16:31:14.0496462Z   foreach ($relative in @(
2026-11-02T16:31:14.0496636Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T16:31:14.0496919Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T16:31:14.0497156Z   )) {
2026-11-02T16:31:14.0497366Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T16:31:14.0497677Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T16:31:14.0497881Z   }
2026-11-02T16:31:14.0498011Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:31:14.0498182Z     Set-Location "$scratch\$variant"
2026-11-02T16:31:14.0498533Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T16:31:14.0498878Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T16:31:14.0499242Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T16:31:14.0499581Z     $exitCode = $LASTEXITCODE
2026-11-02T16:31:14.0499872Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T16:31:14.0500298Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T16:31:14.0500596Z     Write-Host "$variant $($measurement[0])"
2026-11-02T16:31:14.0500746Z   }
2026-11-02T16:31:14.0501544Z   # Replace only the three pre-image-change production files in the
2026-11-02T16:31:14.0501803Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T16:31:14.0502017Z   Set-Location "${drive}:\"
2026-11-02T16:31:14.0502160Z   foreach ($relative in @(
2026-11-02T16:31:14.0502334Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
