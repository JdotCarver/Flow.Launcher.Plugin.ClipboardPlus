2026-11-02T16:31:14.0503904Z   }
2026-11-02T16:31:14.0504035Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:31:14.0504202Z     Set-Location "$scratch\$variant"
2026-11-02T16:31:14.0504569Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T16:31:14.0504922Z     $exitCode = $LASTEXITCODE
2026-11-02T16:31:14.0505313Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T16:31:14.0505750Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T16:31:14.0506038Z     Write-Host "$variant $($measurement[0])"
2026-11-02T16:31:14.0506186Z   }
2026-11-02T16:31:14.0506346Z   # Pinning baseline differs only in the record implementation.
