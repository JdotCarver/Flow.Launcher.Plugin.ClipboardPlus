2026-11-02T16:30:21.6995783Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T16:30:21.6996076Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T16:30:21.6996295Z # repository copies, so their absence is expected there and is
2026-11-02T16:30:21.6996488Z # reported rather than treated as a failure.
2026-11-02T16:30:21.6996642Z $testDirectory = "dev/tests"
2026-11-02T16:30:21.6996787Z if (-not (Test-Path $testDirectory)) {
2026-11-02T16:30:21.6997169Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T16:30:21.6997409Z   exit 0
2026-11-02T16:30:21.6997505Z }
2026-11-02T16:30:21.6997653Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T16:30:21.6997894Z # renamed test directory would report green having run nothing. Count
2026-11-02T16:30:21.6998129Z # them and fail below the expected floor instead.
2026-11-02T16:30:21.6998409Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T16:30:21.6998686Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T16:30:21.6998904Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T16:30:21.6999144Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T16:30:21.6999394Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T16:30:21.6999580Z }
