2026-11-02T15:08:02.2520220Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T15:08:02.2520524Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T15:08:02.2520869Z # repository copies, so their absence is expected there and is
2026-11-02T15:08:02.2521077Z # reported rather than treated as a failure.
2026-11-02T15:08:02.2521235Z $testDirectory = "dev/tests"
2026-11-02T15:08:02.2521382Z if (-not (Test-Path $testDirectory)) {
2026-11-02T15:08:02.2521636Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T15:08:02.2521871Z   exit 0
2026-11-02T15:08:02.2521974Z }
2026-11-02T15:08:02.2522119Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T15:08:02.2522362Z # renamed test directory would report green having run nothing. Count
2026-11-02T15:08:02.2522613Z # them and fail below the expected floor instead.
2026-11-02T15:08:02.2522902Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T15:08:02.2523190Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T15:08:02.2523432Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T15:08:02.2523682Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T15:08:02.2523922Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T15:08:02.2524119Z }
