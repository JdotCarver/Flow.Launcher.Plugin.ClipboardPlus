2026-11-02T15:08:52.9549488Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T15:08:52.9549913Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T15:08:52.9550188Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T15:08:52.9550408Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T15:08:52.9550586Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T15:08:52.9550759Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T15:08:52.9550937Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T15:08:52.9551103Z try {
2026-11-02T15:08:52.9551209Z   Set-Location "${drive}:\"
2026-11-02T15:08:52.9551439Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T15:08:52.9551762Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T15:08:52.9552121Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T15:08:52.9552302Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:08:52.9552506Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T15:08:52.9552743Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T15:08:52.9552920Z   }
2026-11-02T15:08:52.9553174Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T15:08:52.9553641Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T15:08:52.9554003Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T15:08:52.9554227Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T15:08:52.9554443Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T15:08:52.9554628Z   foreach ($relative in @(
2026-11-02T15:08:52.9554793Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T15:08:52.9555059Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T15:08:52.9555289Z   )) {
2026-11-02T15:08:52.9555503Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T15:08:52.9555805Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T15:08:52.9555999Z   }
2026-11-02T15:08:52.9556116Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:08:52.9556274Z     Set-Location "$scratch\$variant"
2026-11-02T15:08:52.9556610Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T15:08:52.9556963Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T15:08:52.9557338Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T15:08:52.9557679Z     $exitCode = $LASTEXITCODE
2026-11-02T15:08:52.9557971Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T15:08:52.9558390Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T15:08:52.9558669Z     Write-Host "$variant $($measurement[0])"
2026-11-02T15:08:52.9558813Z   }
2026-11-02T15:08:52.9559668Z   # Replace only the three pre-image-change production files in the
2026-11-02T15:08:52.9559936Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T15:08:52.9560130Z   Set-Location "${drive}:\"
2026-11-02T15:08:52.9560262Z   foreach ($relative in @(
2026-11-02T15:08:52.9560439Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T15:08:52.9560709Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T15:08:52.9561045Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T15:08:52.9561283Z   )) {
2026-11-02T15:08:52.9561496Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T15:08:52.9561793Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T15:08:52.9561973Z   }
2026-11-02T15:08:52.9562092Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:08:52.9562253Z     Set-Location "$scratch\$variant"
2026-11-02T15:08:52.9562699Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T15:08:52.9563052Z     $exitCode = $LASTEXITCODE
2026-11-02T15:08:52.9563358Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T15:08:52.9563806Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T15:08:52.9564096Z     Write-Host "$variant $($measurement[0])"
2026-11-02T15:08:52.9564234Z   }
2026-11-02T15:08:52.9564328Z } finally {
2026-11-02T15:08:52.9564438Z   Set-Location "${drive}:\"
2026-11-02T15:08:52.9564625Z   Remove-Item $scratch -Recurse -Force -ErrorAction SilentlyContinue
2026-11-02T15:08:52.9564833Z   Set-Location $env:RUNNER_TEMP
2026-11-02T15:08:52.9565004Z   Remove-Item $diagnostic -ErrorAction SilentlyContinue
