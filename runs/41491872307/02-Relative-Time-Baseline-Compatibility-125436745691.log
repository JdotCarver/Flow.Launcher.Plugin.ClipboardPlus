2026-11-02T17:32:01.6057791Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:32:01.6058213Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:32:01.6058480Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:32:01.6058682Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:32:01.6058852Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:32:01.6059020Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:32:01.6059196Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:32:01.6059354Z try {
2026-11-02T17:32:01.6059573Z   Set-Location "${drive}:\"
2026-11-02T17:32:01.6059797Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:32:01.6060127Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:32:01.6060364Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:32:01.6060545Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:32:01.6060751Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:32:01.6060994Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:32:01.6061164Z   }
2026-11-02T17:32:01.6061418Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:32:01.6061880Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:32:01.6062241Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:32:01.6062468Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:32:01.6062683Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:32:01.6062862Z   foreach ($relative in @(
2026-11-02T17:32:01.6063023Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:32:01.6063294Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:32:01.6063521Z   )) {
2026-11-02T17:32:01.6063725Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:32:01.6064035Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:32:01.6064246Z   }
2026-11-02T17:32:01.6064365Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:32:01.6064525Z     Set-Location "$scratch\$variant"
2026-11-02T17:32:01.6064862Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:32:01.6065213Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:32:01.6065587Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:32:01.6065923Z     $exitCode = $LASTEXITCODE
2026-11-02T17:32:01.6066219Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:32:01.6066644Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:32:01.6066930Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:32:01.6067070Z   }
2026-11-02T17:32:01.6067857Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:32:01.6068113Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:32:01.6068302Z   Set-Location "${drive}:\"
2026-11-02T17:32:01.6068432Z   foreach ($relative in @(
2026-11-02T17:32:01.6068598Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:32:01.6068872Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T17:32:01.6069213Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T17:32:01.6069443Z   )) {
2026-11-02T17:32:01.6069648Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:32:01.6070026Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T17:32:01.6070209Z   }
2026-11-02T17:32:01.6070327Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:32:01.6070488Z     Set-Location "$scratch\$variant"
2026-11-02T17:32:01.6070856Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T17:32:01.6071210Z     $exitCode = $LASTEXITCODE
2026-11-02T17:32:01.6071515Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:32:01.6071956Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T17:32:01.6072248Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:32:01.6072390Z   }
2026-11-02T17:32:01.6072532Z   # Pinning baseline differs only in the record implementation.
2026-11-02T17:32:01.6072714Z   Set-Location "${drive}:\"
2026-11-02T17:32:01.6072986Z   git show 537ba8c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs 2>> $diagnostic |
