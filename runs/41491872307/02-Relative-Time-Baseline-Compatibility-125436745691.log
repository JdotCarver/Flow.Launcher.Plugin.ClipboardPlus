2026-11-02T17:31:09.7624311Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:31:09.7624601Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:31:09.7624822Z # repository copies, so their absence is expected there and is
2026-11-02T17:31:09.7625015Z # reported rather than treated as a failure.
2026-11-02T17:31:09.7625167Z $testDirectory = "dev/tests"
2026-11-02T17:31:09.7625314Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:31:09.7625569Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:31:09.7625797Z   exit 0
2026-11-02T17:31:09.7625890Z }
2026-11-02T17:31:09.7626034Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:31:09.7626280Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:31:09.7626515Z # them and fail below the expected floor instead.
2026-11-02T17:31:09.7626795Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:31:09.7627073Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:31:09.7627293Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:31:09.7627535Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:31:09.7627786Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:31:09.7627972Z }
