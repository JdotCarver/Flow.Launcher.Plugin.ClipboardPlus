2026-11-02T21:28:24.1524667Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:28:24.1524887Z # repository copies, so their absence is expected there and is
2026-11-02T21:28:24.1525081Z # reported rather than treated as a failure.
2026-11-02T21:28:24.1525234Z $testDirectory = "dev/tests"
2026-11-02T21:28:24.1525376Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:28:24.1525627Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T21:28:24.1525854Z   exit 0
2026-11-02T21:28:24.1525945Z }
2026-11-02T21:28:24.1526091Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:28:24.1526331Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:28:24.1526564Z # them and fail below the expected floor instead.
2026-11-02T21:28:24.1526841Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:28:24.1527112Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:28:24.1527328Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T21:28:24.1527571Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T21:28:24.1527803Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T21:28:24.1527986Z }
