2026-11-02T21:29:21.7014062Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:29:21.7014529Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:29:21.7014806Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:29:21.7015015Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:29:21.7015207Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:29:21.7015384Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:29:21.7015570Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:29:21.7015739Z try {
2026-11-02T21:29:21.7015851Z   Set-Location "${drive}:\"
2026-11-02T21:29:21.7016081Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:29:21.7016419Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:29:21.7016807Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:29:21.7016996Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:29:21.7017208Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:29:21.7017452Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:29:21.7017631Z   }
2026-11-02T21:29:21.7017795Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:29:21.7018001Z   # cleanup integration in the before snapshot.
2026-11-02T21:29:21.7018322Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:29:21.7018803Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T21:29:21.7019287Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:29:21.7019638Z   # The historical ClipboardData lacks the newer origin marker.
2026-11-02T21:29:21.7020008Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core.Test\WindowsOriginPinTests.cs" -ErrorAction SilentlyContinue
