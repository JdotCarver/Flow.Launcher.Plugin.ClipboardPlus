2026-11-02T17:57:23.1772716Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:57:23.1773144Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:57:23.1773406Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:57:23.1773603Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:57:23.1773773Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:57:23.1773937Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:57:23.1774112Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:57:23.1774271Z try {
2026-11-02T17:57:23.1774373Z   Set-Location "${drive}:\"
2026-11-02T17:57:23.1774589Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:57:23.1774902Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:57:23.1775131Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:57:23.1775313Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:57:23.1775513Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:57:23.1775748Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:57:23.1775919Z   }
2026-11-02T17:57:23.1776171Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:57:23.1776613Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:57:23.1776957Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:57:23.1777176Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:57:23.1777383Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:57:23.1777556Z   foreach ($relative in @(
2026-11-02T17:57:23.1777714Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:57:23.1777978Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:57:23.1778199Z   )) {
2026-11-02T17:57:23.1778401Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:57:23.1778693Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:57:23.1778876Z   }
2026-11-02T17:57:23.1778989Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:57:23.1779142Z     Set-Location "$scratch\$variant"
2026-11-02T17:57:23.1779461Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:57:23.1779927Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:57:23.1780304Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:57:23.1780630Z     $exitCode = $LASTEXITCODE
2026-11-02T17:57:23.1780911Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:57:23.1781316Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:57:23.1781585Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:57:23.1781717Z   }
2026-11-02T17:57:23.1782478Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:57:23.1782729Z   # before snapshot; the same current harness runs in both copies.
