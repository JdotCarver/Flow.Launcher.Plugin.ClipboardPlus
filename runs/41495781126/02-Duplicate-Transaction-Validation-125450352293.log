2026-11-02T17:56:29.9708662Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:56:29.9708887Z # repository copies, so their absence is expected there and is
2026-11-02T17:56:29.9709083Z # reported rather than treated as a failure.
2026-11-02T17:56:29.9709241Z $testDirectory = "dev/tests"
2026-11-02T17:56:29.9709386Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:56:29.9709632Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:56:29.9709859Z   exit 0
2026-11-02T17:56:29.9709953Z }
2026-11-02T17:56:29.9710104Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:56:29.9710344Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:56:29.9710587Z # them and fail below the expected floor instead.
2026-11-02T17:56:29.9710864Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:56:29.9711137Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:56:29.9711355Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:56:29.9711595Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:56:29.9711828Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:56:29.9712009Z }
