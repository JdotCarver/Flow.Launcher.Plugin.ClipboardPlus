2026-11-02T17:33:59.1733334Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:33:59.1733618Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:33:59.1733839Z # repository copies, so their absence is expected there and is
2026-11-02T17:33:59.1734039Z # reported rather than treated as a failure.
2026-11-02T17:33:59.1734192Z $testDirectory = "dev/tests"
2026-11-02T17:33:59.1734341Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:33:59.1734590Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:33:59.1734820Z   exit 0
2026-11-02T17:33:59.1734917Z }
2026-11-02T17:33:59.1735074Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:33:59.1735318Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:33:59.1735582Z # them and fail below the expected floor instead.
2026-11-02T17:33:59.1735857Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:33:59.1736131Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:33:59.1736356Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:33:59.1736599Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:33:59.1736833Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:33:59.1737022Z }
