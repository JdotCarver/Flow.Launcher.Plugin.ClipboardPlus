2026-11-02T17:34:50.0852806Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:34:50.0853225Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:34:50.0853488Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:34:50.0853681Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:34:50.0853871Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:34:50.0854041Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:34:50.0854217Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:34:50.0854378Z try {
2026-11-02T17:34:50.0854620Z   Set-Location "${drive}:\"
2026-11-02T17:34:50.0854844Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:34:50.0855163Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:34:50.0855400Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:34:50.0855578Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:34:50.0855778Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:34:50.0856019Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:34:50.0856189Z   }
2026-11-02T17:34:50.0856441Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:34:50.0856890Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:34:50.0857235Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:34:50.0857457Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:34:50.0857672Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:34:50.0857851Z   foreach ($relative in @(
2026-11-02T17:34:50.0858016Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:34:50.0858279Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:34:50.0858502Z   )) {
2026-11-02T17:34:50.0858706Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:34:50.0859004Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:34:50.0859192Z   }
2026-11-02T17:34:50.0859311Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:34:50.0859470Z     Set-Location "$scratch\$variant"
2026-11-02T17:34:50.0859801Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:34:50.0860138Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:34:50.0860490Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:34:50.0860814Z     $exitCode = $LASTEXITCODE
2026-11-02T17:34:50.0861101Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:34:50.0861504Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:34:50.0861779Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:34:50.0861918Z   }
2026-11-02T17:34:50.0862730Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:34:50.0862978Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:34:50.0863159Z   Set-Location "${drive}:\"
2026-11-02T17:34:50.0863287Z   foreach ($relative in @(
2026-11-02T17:34:50.0863444Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:34:50.0863705Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
