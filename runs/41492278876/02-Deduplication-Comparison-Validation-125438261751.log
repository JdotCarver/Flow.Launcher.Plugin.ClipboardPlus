2026-11-02T17:34:50.0864469Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:34:50.0864836Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T17:34:50.0865020Z   }
2026-11-02T17:34:50.0865139Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:34:50.0865300Z     Set-Location "$scratch\$variant"
2026-11-02T17:34:50.0865656Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T17:34:50.0866005Z     $exitCode = $LASTEXITCODE
