2026-11-02T17:47:35.9031610Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:47:35.9032046Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:47:35.9032325Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:47:35.9032532Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:47:35.9032714Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:47:35.9032891Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:47:35.9033084Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:47:35.9033252Z try {
2026-11-02T17:47:35.9033362Z   Set-Location "${drive}:\"
2026-11-02T17:47:35.9033598Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:47:35.9033930Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:47:35.9034179Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:47:35.9034373Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:47:35.9034588Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:47:35.9034839Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:47:35.9035023Z   }
2026-11-02T17:47:35.9035291Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:47:35.9035747Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:47:35.9036107Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:47:35.9036340Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:47:35.9036564Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:47:35.9036756Z   foreach ($relative in @(
2026-11-02T17:47:35.9036936Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:47:35.9037204Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:47:35.9037439Z   )) {
2026-11-02T17:47:35.9037655Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:47:35.9037968Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:47:35.9038172Z   }
2026-11-02T17:47:35.9038303Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:47:35.9038470Z     Set-Location "$scratch\$variant"
2026-11-02T17:47:35.9038815Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:47:35.9039213Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:47:35.9039746Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:47:35.9040080Z     $exitCode = $LASTEXITCODE
2026-11-02T17:47:35.9040364Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:47:35.9040774Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:47:35.9041052Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:47:35.9041194Z   }
2026-11-02T17:47:35.9041920Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:47:35.9042168Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:47:35.9042355Z   Set-Location "${drive}:\"
2026-11-02T17:47:35.9042486Z   foreach ($relative in @(
2026-11-02T17:47:35.9042646Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:47:35.9042911Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T17:47:35.9043230Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T17:47:35.9043459Z   )) {
2026-11-02T17:47:35.9043662Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:47:35.9043951Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T17:47:35.9044128Z   }
2026-11-02T17:47:35.9044244Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:47:35.9044403Z     Set-Location "$scratch\$variant"
