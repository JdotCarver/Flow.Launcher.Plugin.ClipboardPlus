2026-11-02T17:46:41.4819652Z $testDirectory = "dev/tests"
2026-11-02T17:46:41.4819804Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:46:41.4820059Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:46:41.4820302Z   exit 0
2026-11-02T17:46:41.4820568Z }
2026-11-02T17:46:41.4820881Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:46:41.4821305Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:46:41.4821572Z # them and fail below the expected floor instead.
2026-11-02T17:46:41.4821865Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:46:41.4822155Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:46:41.4822399Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
