2026-11-02T22:17:42.2182486Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:17:42.2182773Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:17:42.2182992Z # repository copies, so their absence is expected there and is
2026-11-02T22:17:42.2183186Z # reported rather than treated as a failure.
2026-11-02T22:17:42.2183337Z $testDirectory = "dev/tests"
2026-11-02T22:17:42.2183486Z if (-not (Test-Path $testDirectory)) {
2026-11-02T22:17:42.2183733Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T22:17:42.2183968Z   exit 0
2026-11-02T22:17:42.2184059Z }
2026-11-02T22:17:42.2184201Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T22:17:42.2184446Z # renamed test directory would report green having run nothing. Count
2026-11-02T22:17:42.2184681Z # them and fail below the expected floor instead.
2026-11-02T22:17:42.2184963Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T22:17:42.2185239Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:17:42.2185475Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T22:17:42.2185724Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T22:17:42.2185964Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T22:17:42.2186146Z }
