2026-11-02T22:18:40.6709323Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:18:40.6709763Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:18:40.6710027Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T22:18:40.6710226Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T22:18:40.6710398Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:18:40.6710565Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T22:18:40.6710744Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T22:18:40.6710901Z try {
2026-11-02T22:18:40.6711003Z   Set-Location "${drive}:\"
2026-11-02T22:18:40.6711220Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T22:18:40.6711671Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T22:18:40.6711910Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T22:18:40.6712087Z   foreach ($variant in @('before', 'after')) {
2026-11-02T22:18:40.6712289Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T22:18:40.6712526Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T22:18:40.6712723Z   }
2026-11-02T22:18:40.6712886Z   # The historical caller is not partial and cannot include the new
2026-11-02T22:18:40.6713122Z   # cleanup integration in the before snapshot.
2026-11-02T22:18:40.6713458Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T22:18:40.6713956Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T22:18:40.6714445Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T22:18:40.6714802Z   # The historical ClipboardData lacks the newer origin marker.
