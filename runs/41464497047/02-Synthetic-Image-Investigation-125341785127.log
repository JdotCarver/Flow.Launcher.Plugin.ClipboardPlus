2026-11-02T14:43:36.5234014Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T14:43:36.5234412Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T14:43:36.5234681Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T14:43:36.5234878Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T14:43:36.5235047Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:43:36.5235214Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T14:43:36.5235389Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T14:43:36.5235550Z try {
2026-11-02T14:43:36.5235651Z   Set-Location "${drive}:\"
2026-11-02T14:43:36.5235871Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T14:43:36.5236185Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T14:43:36.5236421Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T14:43:36.5236597Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:43:36.5236801Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T14:43:36.5237038Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T14:43:36.5237208Z   }
2026-11-02T14:43:36.5237454Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T14:43:36.5237902Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T14:43:36.5238239Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T14:43:36.5238434Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:43:36.5238590Z     Set-Location "$scratch\$variant"
2026-11-02T14:43:36.5238904Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T14:43:36.5239400Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T14:43:36.5239766Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T14:43:36.5240104Z     $exitCode = $LASTEXITCODE
2026-11-02T14:43:36.5240395Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T14:43:36.5240809Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T14:43:36.5241083Z     Write-Host "$variant $($measurement[0])"
2026-11-02T14:43:36.5241223Z   }
2026-11-02T14:43:36.5241319Z } finally {
2026-11-02T14:43:36.5241426Z   Set-Location "${drive}:\"
2026-11-02T14:43:36.5241614Z   Remove-Item $scratch -Recurse -Force -ErrorAction SilentlyContinue
2026-11-02T14:43:36.5241811Z   Set-Location $env:RUNNER_TEMP
2026-11-02T14:43:36.5241980Z   Remove-Item $diagnostic -ErrorAction SilentlyContinue
2026-11-02T14:43:36.5242150Z   subst "${drive}:" /d
2026-11-02T14:43:36.5242262Z }
