2026-11-02T14:42:47.3071658Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:42:47.3071944Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:42:47.3072292Z # repository copies, so their absence is expected there and is
2026-11-02T14:42:47.3072488Z # reported rather than treated as a failure.
2026-11-02T14:42:47.3072642Z $testDirectory = "dev/tests"
2026-11-02T14:42:47.3072786Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:42:47.3073031Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:42:47.3073259Z   exit 0
2026-11-02T14:42:47.3073351Z }
2026-11-02T14:42:47.3073497Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:42:47.3073735Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:42:47.3073968Z # them and fail below the expected floor instead.
2026-11-02T14:42:47.3074251Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:42:47.3074528Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:42:47.3074786Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:42:47.3075027Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:42:47.3075259Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:42:47.3075442Z }
