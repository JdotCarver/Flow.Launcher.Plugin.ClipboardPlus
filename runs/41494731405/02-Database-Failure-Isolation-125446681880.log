2026-11-02T17:49:38.9304442Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:49:38.9304745Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:49:38.9304970Z # repository copies, so their absence is expected there and is
2026-11-02T17:49:38.9305169Z # reported rather than treated as a failure.
2026-11-02T17:49:38.9305318Z $testDirectory = "dev/tests"
2026-11-02T17:49:38.9305463Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:49:38.9305713Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:49:38.9305941Z   exit 0
2026-11-02T17:49:38.9306032Z }
2026-11-02T17:49:38.9306179Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:49:38.9306423Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:49:38.9306660Z # them and fail below the expected floor instead.
2026-11-02T17:49:38.9306940Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:49:38.9307213Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:49:38.9307430Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:49:38.9307668Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:49:38.9307895Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:49:38.9308077Z }
