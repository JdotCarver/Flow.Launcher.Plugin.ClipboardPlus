2026-11-02T17:50:43.7332797Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:50:43.7333215Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:50:43.7333481Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:50:43.7333680Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:50:43.7333846Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:50:43.7334006Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:50:43.7334181Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:50:43.7334337Z try {
2026-11-02T17:50:43.7334437Z   Set-Location "${drive}:\"
2026-11-02T17:50:43.7334655Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:50:43.7334975Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:50:43.7335204Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:50:43.7335377Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:50:43.7335572Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:50:43.7335804Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:50:43.7335972Z   }
2026-11-02T17:50:43.7336220Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:50:43.7336665Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:50:43.7337016Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:50:43.7337348Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:50:43.7337566Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:50:43.7337796Z   foreach ($relative in @(
2026-11-02T17:50:43.7337956Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:50:43.7338277Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:50:43.7338499Z   )) {
2026-11-02T17:50:43.7338697Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:50:43.7338996Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:50:43.7339182Z   }
2026-11-02T17:50:43.7339298Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:50:43.7339453Z     Set-Location "$scratch\$variant"
2026-11-02T17:50:43.7339779Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:50:43.7340185Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:50:43.7340544Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:50:43.7340869Z     $exitCode = $LASTEXITCODE
2026-11-02T17:50:43.7341153Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:50:43.7341560Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:50:43.7341834Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:50:43.7341973Z   }
2026-11-02T17:50:43.7385031Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:50:43.7385379Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:50:43.7385568Z   Set-Location "${drive}:\"
