2026-11-02T22:29:42.5795048Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:29:42.5795266Z # repository copies, so their absence is expected there and is
2026-11-02T22:29:42.5795461Z # reported rather than treated as a failure.
2026-11-02T22:29:42.5795607Z $testDirectory = "dev/tests"
2026-11-02T22:29:42.5795746Z if (-not (Test-Path $testDirectory)) {
2026-11-02T22:29:42.5795985Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T22:29:42.5796216Z   exit 0
2026-11-02T22:29:42.5796301Z }
2026-11-02T22:29:42.5796439Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T22:29:42.5796676Z # renamed test directory would report green having run nothing. Count
2026-11-02T22:29:42.5796906Z # them and fail below the expected floor instead.
2026-11-02T22:29:42.5797179Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T22:29:42.5797451Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:29:42.5797664Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T22:29:42.5797898Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T22:29:42.5798129Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T22:29:42.5798312Z }
