2026-11-02T22:30:43.9877025Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:30:43.9877531Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:30:43.9878002Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T22:30:43.9878249Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T22:30:43.9878460Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:30:43.9878658Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T22:30:43.9878879Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T22:30:43.9879084Z try {
2026-11-02T22:30:43.9879212Z   Set-Location "${drive}:\"
2026-11-02T22:30:43.9879483Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T22:30:43.9879838Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T22:30:43.9880085Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T22:30:43.9880277Z   foreach ($variant in @('before', 'after')) {
2026-11-02T22:30:43.9880491Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T22:30:43.9880743Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T22:30:43.9880929Z   }
