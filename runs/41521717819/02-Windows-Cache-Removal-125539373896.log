2026-11-02T20:44:58.7631227Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:44:58.7631721Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:44:58.7632005Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:44:58.7632219Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:44:58.7632409Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:44:58.7632586Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:44:58.7632774Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:44:58.7632945Z try {
2026-11-02T20:44:58.7633061Z   Set-Location "${drive}:\"
2026-11-02T20:44:58.7633292Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:44:58.7633633Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:44:58.7633887Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:44:58.7634075Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:44:58.7634288Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:44:58.7634535Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:44:58.7634845Z   }
2026-11-02T20:44:58.7635019Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:44:58.7635229Z   # cleanup integration in the before snapshot.
2026-11-02T20:44:58.7635558Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:44:58.7636075Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T20:44:58.7636579Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:44:58.7637056Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:44:58.7637515Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:44:58.7637879Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:44:58.7638111Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T20:44:58.7638337Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T20:44:58.7638529Z   foreach ($relative in @(
2026-11-02T20:44:58.7638702Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
