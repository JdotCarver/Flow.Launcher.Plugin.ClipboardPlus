2026-11-02T20:43:59.6599050Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:43:59.6599362Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:43:59.6599593Z # repository copies, so their absence is expected there and is
2026-11-02T20:43:59.6599793Z # reported rather than treated as a failure.
2026-11-02T20:43:59.6599948Z $testDirectory = "dev/tests"
2026-11-02T20:43:59.6600096Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:43:59.6600350Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:43:59.6600586Z   exit 0
2026-11-02T20:43:59.6600681Z }
2026-11-02T20:43:59.6600831Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:43:59.6601082Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:43:59.6601325Z # them and fail below the expected floor instead.
2026-11-02T20:43:59.6601617Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:43:59.6601892Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:43:59.6602114Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:43:59.6602359Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:43:59.6602600Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:43:59.6602790Z }
