2026-11-02T17:37:42.2324019Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:37:42.2324456Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:37:42.2324735Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:37:42.2324939Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:37:42.2325116Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:37:42.2325291Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:37:42.2325472Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:37:42.2325637Z try {
2026-11-02T17:37:42.2325876Z   Set-Location "${drive}:\"
2026-11-02T17:37:42.2326108Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:37:42.2326438Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:37:42.2326682Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:37:42.2326866Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:37:42.2327076Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:37:42.2327318Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:37:42.2327499Z   }
2026-11-02T17:37:42.2327763Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:37:42.2328229Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:37:42.2328594Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:37:42.2328823Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:37:42.2329049Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:37:42.2329234Z   foreach ($relative in @(
2026-11-02T17:37:42.2329399Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:37:42.2329681Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:37:42.2329911Z   )) {
2026-11-02T17:37:42.2330124Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:37:42.2330439Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:37:42.2330639Z   }
2026-11-02T17:37:42.2330757Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:37:42.2330916Z     Set-Location "$scratch\$variant"
2026-11-02T17:37:42.2331258Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:37:42.2331611Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:37:42.2332004Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:37:42.2332352Z     $exitCode = $LASTEXITCODE
2026-11-02T17:37:42.2332652Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:37:42.2333087Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:37:42.2333377Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:37:42.2333520Z   }
2026-11-02T17:37:42.2334303Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:37:42.2334559Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:37:42.2334745Z   Set-Location "${drive}:\"
2026-11-02T17:37:42.2334876Z   foreach ($relative in @(
2026-11-02T17:37:42.2335043Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:37:42.2335317Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T17:37:42.2335658Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T17:37:42.2335884Z   )) {
2026-11-02T17:37:42.2336100Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:37:42.2336486Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T17:37:42.2336671Z   }
2026-11-02T17:37:42.2336799Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:37:42.2336963Z     Set-Location "$scratch\$variant"
2026-11-02T17:37:42.2337333Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T17:37:42.2337696Z     $exitCode = $LASTEXITCODE
2026-11-02T17:37:42.2338012Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:37:42.2338470Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T17:37:42.2338762Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:37:42.2338903Z   }
