2026-11-02T17:36:48.9512891Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:36:48.9513200Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:36:48.9513431Z # repository copies, so their absence is expected there and is
2026-11-02T17:36:48.9513636Z # reported rather than treated as a failure.
2026-11-02T17:36:48.9513797Z $testDirectory = "dev/tests"
2026-11-02T17:36:48.9514037Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:36:48.9514374Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:36:48.9514623Z   exit 0
2026-11-02T17:36:48.9514717Z }
2026-11-02T17:36:48.9514866Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:36:48.9515116Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:36:48.9515388Z # them and fail below the expected floor instead.
2026-11-02T17:36:48.9515681Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:36:48.9515973Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:36:48.9516202Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:36:48.9516454Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:36:48.9516701Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:36:48.9516891Z }
