2026-11-02T22:43:57.6891567Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:43:57.6891786Z # repository copies, so their absence is expected there and is
2026-11-02T22:43:57.6891979Z # reported rather than treated as a failure.
2026-11-02T22:43:57.6892128Z $testDirectory = "dev/tests"
2026-11-02T22:43:57.6892272Z if (-not (Test-Path $testDirectory)) {
2026-11-02T22:43:57.6892515Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T22:43:57.6892745Z   exit 0
2026-11-02T22:43:57.6892835Z }
2026-11-02T22:43:57.6892980Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T22:43:57.6893218Z # renamed test directory would report green having run nothing. Count
2026-11-02T22:43:57.6893453Z # them and fail below the expected floor instead.
2026-11-02T22:43:57.6893729Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T22:43:57.6894001Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:43:57.6894215Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T22:43:57.6894453Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T22:43:57.6894686Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T22:43:57.6894864Z }
