2026-11-02T18:24:24.2976752Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:24:24.2976970Z # repository copies, so their absence is expected there and is
2026-11-02T18:24:24.2977166Z # reported rather than treated as a failure.
2026-11-02T18:24:24.2977323Z $testDirectory = "dev/tests"
2026-11-02T18:24:24.2977473Z if (-not (Test-Path $testDirectory)) {
2026-11-02T18:24:24.2977717Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T18:24:24.2977948Z   exit 0
2026-11-02T18:24:24.2978040Z }
2026-11-02T18:24:24.2978183Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T18:24:24.2978414Z # renamed test directory would report green having run nothing. Count
2026-11-02T18:24:24.2978643Z # them and fail below the expected floor instead.
2026-11-02T18:24:24.2978926Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T18:24:24.2979193Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:24:24.2979425Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T18:24:24.2979667Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T18:24:24.2979902Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T18:24:24.2980092Z }
