2026-11-02T18:25:19.1952641Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:25:19.1953072Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:25:19.1953330Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T18:25:19.1953527Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T18:25:19.1953702Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:25:19.1953869Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T18:25:19.1954054Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T18:25:19.1954231Z try {
2026-11-02T18:25:19.1954340Z   Set-Location "${drive}:\"
2026-11-02T18:25:19.1954574Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T18:25:19.1954906Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T18:25:19.1955143Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T18:25:19.1955326Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:25:19.1955534Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T18:25:19.1955782Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T18:25:19.1955958Z   }
2026-11-02T18:25:19.1956218Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T18:25:19.1956686Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T18:25:19.1957035Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T18:25:19.1957264Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T18:25:19.1957484Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T18:25:19.1957684Z   foreach ($relative in @(
2026-11-02T18:25:19.1957851Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:25:19.1958118Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T18:25:19.1958348Z   )) {
2026-11-02T18:25:19.1958557Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T18:25:19.1958859Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T18:25:19.1959185Z   }
2026-11-02T18:25:19.1959314Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:25:19.1959479Z     Set-Location "$scratch\$variant"
2026-11-02T18:25:19.1959818Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T18:25:19.1960170Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T18:25:19.1960530Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T18:25:19.1960862Z     $exitCode = $LASTEXITCODE
2026-11-02T18:25:19.1961153Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T18:25:19.1961563Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T18:25:19.1961837Z     Write-Host "$variant $($measurement[0])"
2026-11-02T18:25:19.1961981Z   }
2026-11-02T18:25:19.1962750Z   # Replace only the three pre-image-change production files in the
2026-11-02T18:25:19.1963000Z   # before snapshot; the same current harness runs in both copies.
