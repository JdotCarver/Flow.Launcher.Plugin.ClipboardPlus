2026-11-02T22:24:48.7518603Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:24:48.7519067Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:24:48.7519521Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T22:24:48.7519762Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T22:24:48.7519968Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:24:48.7520171Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T22:24:48.7520395Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T22:24:48.7520587Z try {
2026-11-02T22:24:48.7520714Z   Set-Location "${drive}:\"
2026-11-02T22:24:48.7520983Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T22:24:48.7521361Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T22:24:48.7521607Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T22:24:48.7521797Z   foreach ($variant in @('before', 'after')) {
2026-11-02T22:24:48.7522007Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T22:24:48.7522256Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T22:24:48.7522440Z   }
2026-11-02T22:24:48.7522591Z   # The historical caller is not partial and cannot include the new
