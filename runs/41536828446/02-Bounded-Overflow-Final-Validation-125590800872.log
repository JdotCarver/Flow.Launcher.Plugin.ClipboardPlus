2026-11-02T22:23:47.7781286Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:23:47.7781504Z # repository copies, so their absence is expected there and is
2026-11-02T22:23:47.7781693Z # reported rather than treated as a failure.
2026-11-02T22:23:47.7781843Z $testDirectory = "dev/tests"
2026-11-02T22:23:47.7781984Z if (-not (Test-Path $testDirectory)) {
2026-11-02T22:23:47.7782226Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T22:23:47.7782453Z   exit 0
2026-11-02T22:23:47.7782541Z }
2026-11-02T22:23:47.7782686Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T22:23:47.7782934Z # renamed test directory would report green having run nothing. Count
2026-11-02T22:23:47.7783176Z # them and fail below the expected floor instead.
2026-11-02T22:23:47.7783457Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T22:23:47.7783729Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:23:47.7783946Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T22:23:47.7784187Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T22:23:47.7784578Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T22:23:47.7784801Z }
