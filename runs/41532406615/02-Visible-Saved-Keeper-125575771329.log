2026-11-02T21:53:47.2624114Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:53:47.2624550Z # repository copies, so their absence is expected there and is
2026-11-02T21:53:47.2624922Z # reported rather than treated as a failure.
2026-11-02T21:53:47.2625210Z $testDirectory = "dev/tests"
2026-11-02T21:53:47.2625472Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:53:47.2625936Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T21:53:47.2626365Z   exit 0
2026-11-02T21:53:47.2626526Z }
2026-11-02T21:53:47.2626785Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:53:47.2627249Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:53:47.2627687Z # them and fail below the expected floor instead.
2026-11-02T21:53:47.2628222Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:53:47.2628718Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:53:47.2628952Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T21:53:47.2629196Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T21:53:47.2629428Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T21:53:47.2629609Z }
