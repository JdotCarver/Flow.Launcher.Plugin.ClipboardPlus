2026-11-02T21:54:44.9652658Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:54:44.9653094Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:54:44.9653357Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:54:44.9653549Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:54:44.9653714Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:54:44.9653874Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:54:44.9654050Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:54:44.9654205Z try {
2026-11-02T21:54:44.9654303Z   Set-Location "${drive}:\"
2026-11-02T21:54:44.9654520Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:54:44.9654963Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:54:44.9655200Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:54:44.9655379Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:54:44.9655580Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:54:44.9655812Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:54:44.9655979Z   }
2026-11-02T21:54:44.9656123Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:54:44.9656318Z   # cleanup integration in the before snapshot.
