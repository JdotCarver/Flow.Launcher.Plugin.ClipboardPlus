2026-11-02T20:48:15.9850813Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:48:15.9851290Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:48:15.9851572Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:48:15.9851801Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:48:15.9851989Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:48:15.9852169Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:48:15.9852357Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:48:15.9852528Z try {
2026-11-02T20:48:15.9852647Z   Set-Location "${drive}:\"
2026-11-02T20:48:15.9852882Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:48:15.9853219Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:48:15.9853466Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:48:15.9853657Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:48:15.9853874Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:48:15.9854145Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:48:15.9854469Z   }
2026-11-02T20:48:15.9854630Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:48:15.9854854Z   # cleanup integration in the before snapshot.
2026-11-02T20:48:15.9855190Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:48:15.9855694Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T20:48:15.9856209Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:48:15.9856684Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:48:15.9857154Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:48:15.9857529Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:48:15.9857769Z   # The old database lacks the new image-reuse API, so use the
