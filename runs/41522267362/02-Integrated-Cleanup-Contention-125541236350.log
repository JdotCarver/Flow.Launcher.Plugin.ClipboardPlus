2026-11-02T20:47:11.9059327Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:47:11.9059561Z # repository copies, so their absence is expected there and is
2026-11-02T20:47:11.9059768Z # reported rather than treated as a failure.
2026-11-02T20:47:11.9059925Z $testDirectory = "dev/tests"
2026-11-02T20:47:11.9060073Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:47:11.9060334Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:47:11.9060582Z   exit 0
2026-11-02T20:47:11.9060675Z }
2026-11-02T20:47:11.9060828Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:47:11.9061084Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:47:11.9061347Z # them and fail below the expected floor instead.
2026-11-02T20:47:11.9061649Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:47:11.9061943Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:47:11.9062171Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:47:11.9062425Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:47:11.9062677Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:47:11.9062866Z }
