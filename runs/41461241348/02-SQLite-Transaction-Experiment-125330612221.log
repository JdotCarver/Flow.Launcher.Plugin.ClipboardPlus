2026-11-02T14:22:16.1008131Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:22:16.1008451Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:22:16.1008797Z # repository copies, so their absence is expected there and is
2026-11-02T14:22:16.1008999Z # reported rather than treated as a failure.
2026-11-02T14:22:16.1009155Z $testDirectory = "dev/tests"
2026-11-02T14:22:16.1009302Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:22:16.1009557Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:22:16.1009786Z   exit 0
2026-11-02T14:22:16.1009882Z }
2026-11-02T14:22:16.1010026Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:22:16.1010262Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:22:16.1010503Z # them and fail below the expected floor instead.
2026-11-02T14:22:16.1010791Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:22:16.1011071Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:22:16.1011319Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:22:16.1011563Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:22:16.1011796Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:22:16.1011980Z }
