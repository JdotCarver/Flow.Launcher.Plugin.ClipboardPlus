2026-11-02T15:02:30.7275606Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T15:02:30.7276021Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T15:02:30.7276284Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T15:02:30.7276486Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T15:02:30.7276662Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T15:02:30.7276830Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T15:02:30.7277019Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T15:02:30.7277183Z try {
2026-11-02T15:02:30.7277289Z   Set-Location "${drive}:\"
2026-11-02T15:02:30.7277517Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T15:02:30.7277830Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T15:02:30.7278069Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T15:02:30.7278251Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:02:30.7278456Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T15:02:30.7278696Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T15:02:30.7278870Z   }
2026-11-02T15:02:30.7279119Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T15:02:30.7279697Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T15:02:30.7280047Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T15:02:30.7280273Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T15:02:30.7280494Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T15:02:30.7280692Z   foreach ($relative in @(
2026-11-02T15:02:30.7280858Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T15:02:30.7281119Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T15:02:30.7281344Z   )) {
2026-11-02T15:02:30.7281550Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T15:02:30.7281850Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T15:02:30.7282039Z   }
2026-11-02T15:02:30.7282155Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:02:30.7282315Z     Set-Location "$scratch\$variant"
2026-11-02T15:02:30.7282645Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T15:02:30.7282990Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T15:02:30.7283347Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T15:02:30.7283672Z     $exitCode = $LASTEXITCODE
2026-11-02T15:02:30.7283959Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T15:02:30.7284373Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T15:02:30.7284646Z     Write-Host "$variant $($measurement[0])"
2026-11-02T15:02:30.7284786Z   }
2026-11-02T15:02:30.7285545Z   # Replace only the three pre-image-change production files in the
2026-11-02T15:02:30.7285797Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T15:02:30.7285986Z   Set-Location "${drive}:\"
2026-11-02T15:02:30.7286120Z   foreach ($relative in @(
2026-11-02T15:02:30.7286285Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T15:02:30.7286555Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T15:02:30.7286885Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T15:02:30.7287116Z   )) {
2026-11-02T15:02:30.7287325Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T15:02:30.7287619Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T15:02:30.7287805Z   }
2026-11-02T15:02:30.7287927Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:02:30.7288092Z     Set-Location "$scratch\$variant"
2026-11-02T15:02:30.7288444Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T15:02:30.7288794Z     $exitCode = $LASTEXITCODE
2026-11-02T15:02:30.7289093Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T15:02:30.7289526Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T15:02:30.7289881Z     Write-Host "$variant $($measurement[0])"
2026-11-02T15:02:30.7290023Z   }
2026-11-02T15:02:30.7290117Z } finally {
2026-11-02T15:02:30.7290228Z   Set-Location "${drive}:\"
2026-11-02T15:02:30.7290418Z   Remove-Item $scratch -Recurse -Force -ErrorAction SilentlyContinue
2026-11-02T15:02:30.7290625Z   Set-Location $env:RUNNER_TEMP
2026-11-02T15:02:30.7290811Z   Remove-Item $diagnostic -ErrorAction SilentlyContinue
2026-11-02T15:02:30.7290980Z   subst "${drive}:" /d
2026-11-02T15:02:30.7291097Z }
