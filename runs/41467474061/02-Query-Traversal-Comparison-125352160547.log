2026-11-02T15:01:39.7773778Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T15:01:39.7774078Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T15:01:39.7774643Z # repository copies, so their absence is expected there and is
2026-11-02T15:01:39.7774846Z # reported rather than treated as a failure.
2026-11-02T15:01:39.7775005Z $testDirectory = "dev/tests"
2026-11-02T15:01:39.7775157Z if (-not (Test-Path $testDirectory)) {
2026-11-02T15:01:39.7775410Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T15:01:39.7775644Z   exit 0
2026-11-02T15:01:39.7775739Z }
2026-11-02T15:01:39.7775889Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T15:01:39.7776153Z # renamed test directory would report green having run nothing. Count
2026-11-02T15:01:39.7776397Z # them and fail below the expected floor instead.
2026-11-02T15:01:39.7776688Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T15:01:39.7776973Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T15:01:39.7777314Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T15:01:39.7777566Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T15:01:39.7777809Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T15:01:39.7777998Z }
