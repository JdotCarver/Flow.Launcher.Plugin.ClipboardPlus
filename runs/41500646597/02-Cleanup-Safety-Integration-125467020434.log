2026-11-02T18:28:05.9290358Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:28:05.9290810Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:28:05.9291081Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T18:28:05.9291284Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T18:28:05.9291462Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:28:05.9291634Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T18:28:05.9291825Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T18:28:05.9291999Z try {
2026-11-02T18:28:05.9292109Z   Set-Location "${drive}:\"
2026-11-02T18:28:05.9292336Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T18:28:05.9292664Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T18:28:05.9292914Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T18:28:05.9293103Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:28:05.9293316Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T18:28:05.9293564Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T18:28:05.9293751Z   }
2026-11-02T18:28:05.9294015Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T18:28:05.9294473Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T18:28:05.9294826Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T18:28:05.9295057Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T18:28:05.9295278Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T18:28:05.9295461Z   foreach ($relative in @(
2026-11-02T18:28:05.9295637Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:28:05.9295907Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T18:28:05.9296138Z   )) {
2026-11-02T18:28:05.9296349Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T18:28:05.9296655Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T18:28:05.9297005Z   }
2026-11-02T18:28:05.9297128Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:28:05.9297301Z     Set-Location "$scratch\$variant"
2026-11-02T18:28:05.9297648Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T18:28:05.9298019Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T18:28:05.9298381Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T18:28:05.9298716Z     $exitCode = $LASTEXITCODE
2026-11-02T18:28:05.9299006Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T18:28:05.9299440Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T18:28:05.9299736Z     Write-Host "$variant $($measurement[0])"
2026-11-02T18:28:05.9299885Z   }
2026-11-02T18:28:05.9300742Z   # Replace only the three pre-image-change production files in the
2026-11-02T18:28:05.9301006Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T18:28:05.9301201Z   Set-Location "${drive}:\"
2026-11-02T18:28:05.9301341Z   foreach ($relative in @(
2026-11-02T18:28:05.9301502Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:28:05.9301778Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
