2026-11-02T18:27:10.6660550Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:27:10.6660775Z # repository copies, so their absence is expected there and is
2026-11-02T18:27:10.6660976Z # reported rather than treated as a failure.
2026-11-02T18:27:10.6661130Z $testDirectory = "dev/tests"
2026-11-02T18:27:10.6661277Z if (-not (Test-Path $testDirectory)) {
2026-11-02T18:27:10.6661664Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T18:27:10.6661909Z   exit 0
2026-11-02T18:27:10.6662005Z }
2026-11-02T18:27:10.6662153Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T18:27:10.6662392Z # renamed test directory would report green having run nothing. Count
2026-11-02T18:27:10.6662644Z # them and fail below the expected floor instead.
2026-11-02T18:27:10.6662931Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T18:27:10.6663206Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:27:10.6663425Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T18:27:10.6663668Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T18:27:10.6663905Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T18:27:10.6664093Z }
