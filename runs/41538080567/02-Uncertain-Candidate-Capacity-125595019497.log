2026-11-02T22:32:31.2736186Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:32:31.2736405Z # repository copies, so their absence is expected there and is
2026-11-02T22:32:31.2736599Z # reported rather than treated as a failure.
2026-11-02T22:32:31.2736751Z $testDirectory = "dev/tests"
2026-11-02T22:32:31.2736896Z if (-not (Test-Path $testDirectory)) {
2026-11-02T22:32:31.2737143Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T22:32:31.2737380Z   exit 0
2026-11-02T22:32:31.2737473Z }
2026-11-02T22:32:31.2737617Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T22:32:31.2737861Z # renamed test directory would report green having run nothing. Count
2026-11-02T22:32:31.2738096Z # them and fail below the expected floor instead.
2026-11-02T22:32:31.2738376Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T22:32:31.2738651Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:32:31.2738868Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T22:32:31.2739110Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T22:32:31.2739350Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T22:32:31.2739533Z }
