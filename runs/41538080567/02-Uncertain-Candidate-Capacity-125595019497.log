2026-11-02T22:33:31.5783307Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:33:31.5783767Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:33:31.5784164Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T22:33:31.5784376Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T22:33:31.5784558Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:33:31.5784730Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T22:33:31.5784920Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T22:33:31.5785102Z try {
2026-11-02T22:33:31.5785213Z   Set-Location "${drive}:\"
2026-11-02T22:33:31.5785443Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T22:33:31.5785773Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T22:33:31.5786147Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T22:33:31.5786565Z   foreach ($variant in @('before', 'after')) {
2026-11-02T22:33:31.5786933Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T22:33:31.5787418Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T22:33:31.5787656Z   }
2026-11-02T22:33:31.5787819Z   # The historical caller is not partial and cannot include the new
