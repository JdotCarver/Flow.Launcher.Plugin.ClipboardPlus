2026-11-02T14:06:58.9042273Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:06:58.9042567Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:06:58.9042796Z # repository copies, so their absence is expected there and is
2026-11-02T14:06:58.9042999Z # reported rather than treated as a failure.
2026-11-02T14:06:58.9043155Z $testDirectory = "dev/tests"
2026-11-02T14:06:58.9043305Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:06:58.9043565Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:06:58.9043814Z   exit 0
2026-11-02T14:06:58.9043908Z }
2026-11-02T14:06:58.9044057Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:06:58.9044302Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:06:58.9044546Z # them and fail below the expected floor instead.
2026-11-02T14:06:58.9044836Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:06:58.9045124Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:06:58.9045361Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:06:58.9045613Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:06:58.9045858Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:06:58.9046052Z }
