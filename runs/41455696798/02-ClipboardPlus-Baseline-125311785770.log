2026-11-02T13:45:52.5196166Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T13:45:52.5196408Z # renamed test directory would report green having run nothing. Count
2026-11-02T13:45:52.5196651Z # them and fail below the expected floor instead.
2026-11-02T13:45:52.5196936Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
