2026-11-02T18:43:18.7116320Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:43:18.7116611Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:43:18.7116834Z # repository copies, so their absence is expected there and is
2026-11-02T18:43:18.7117030Z # reported rather than treated as a failure.
2026-11-02T18:43:18.7117182Z $testDirectory = "dev/tests"
2026-11-02T18:43:18.7117327Z if (-not (Test-Path $testDirectory)) {
2026-11-02T18:43:18.7117575Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T18:43:18.7117803Z   exit 0
2026-11-02T18:43:18.7117895Z }
2026-11-02T18:43:18.7118045Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T18:43:18.7118281Z # renamed test directory would report green having run nothing. Count
2026-11-02T18:43:18.7118519Z # them and fail below the expected floor instead.
2026-11-02T18:43:18.7118807Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T18:43:18.7119081Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:43:18.7119300Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T18:43:18.7119544Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T18:43:18.7119773Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T18:43:18.7119957Z }
