2026-11-02T18:44:14.6944143Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:44:14.6944565Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:44:14.6944828Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T18:44:14.6945024Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T18:44:14.6945197Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:44:14.6945360Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T18:44:14.6945535Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T18:44:14.6945695Z try {
2026-11-02T18:44:14.6945796Z   Set-Location "${drive}:\"
2026-11-02T18:44:14.6946034Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T18:44:14.6946348Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T18:44:14.6946587Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T18:44:14.6946765Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:44:14.6946965Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T18:44:14.6947204Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T18:44:14.6947372Z   }
2026-11-02T18:44:14.6947622Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T18:44:14.6948064Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T18:44:14.6948408Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T18:44:14.6948626Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T18:44:14.6948976Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T18:44:14.6949157Z   foreach ($relative in @(
2026-11-02T18:44:14.6949317Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:44:14.6949575Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T18:44:14.6949797Z   )) {
2026-11-02T18:44:14.6949998Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T18:44:14.6950299Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T18:44:14.6950483Z   }
2026-11-02T18:44:14.6950593Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:44:14.6950749Z     Set-Location "$scratch\$variant"
2026-11-02T18:44:14.6951067Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T18:44:14.6951402Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T18:44:14.6951757Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T18:44:14.6952081Z     $exitCode = $LASTEXITCODE
2026-11-02T18:44:14.6952364Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
