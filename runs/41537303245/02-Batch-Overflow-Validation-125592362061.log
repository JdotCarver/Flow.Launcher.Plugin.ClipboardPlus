2026-11-02T22:27:58.2812392Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:27:58.2812867Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:27:58.2813262Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T22:27:58.2813466Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T22:27:58.2813647Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:27:58.2813822Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T22:27:58.2814018Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T22:27:58.2814187Z try {
2026-11-02T22:27:58.2814298Z   Set-Location "${drive}:\"
2026-11-02T22:27:58.2814530Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T22:27:58.2814862Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T22:27:58.2815109Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T22:27:58.2815302Z   foreach ($variant in @('before', 'after')) {
2026-11-02T22:27:58.2815516Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T22:27:58.2815763Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T22:27:58.2815944Z   }
