2026-11-02T22:26:56.9488886Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:26:56.9489102Z # repository copies, so their absence is expected there and is
2026-11-02T22:26:56.9489294Z # reported rather than treated as a failure.
2026-11-02T22:26:56.9489446Z $testDirectory = "dev/tests"
2026-11-02T22:26:56.9489587Z if (-not (Test-Path $testDirectory)) {
2026-11-02T22:26:56.9489831Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T22:26:56.9490057Z   exit 0
2026-11-02T22:26:56.9490146Z }
2026-11-02T22:26:56.9490289Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T22:26:56.9490524Z # renamed test directory would report green having run nothing. Count
2026-11-02T22:26:56.9490750Z # them and fail below the expected floor instead.
2026-11-02T22:26:56.9491025Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T22:26:56.9491286Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:26:56.9491496Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T22:26:56.9491731Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T22:26:56.9491964Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T22:26:56.9492142Z }
