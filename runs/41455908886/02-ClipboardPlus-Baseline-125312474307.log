2026-11-02T13:47:02.8659458Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:47:02.8659737Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:47:02.8659950Z # repository copies, so their absence is expected there and is
2026-11-02T13:47:02.8660141Z # reported rather than treated as a failure.
2026-11-02T13:47:02.8660291Z $testDirectory = "dev/tests"
2026-11-02T13:47:02.8660433Z if (-not (Test-Path $testDirectory)) {
2026-11-02T13:47:02.8660676Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T13:47:02.8660903Z   exit 0
2026-11-02T13:47:02.8660997Z }
2026-11-02T13:47:02.8661144Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T13:47:02.8661381Z # renamed test directory would report green having run nothing. Count
2026-11-02T13:47:02.8661610Z # them and fail below the expected floor instead.
2026-11-02T13:47:02.8661881Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T13:47:02.8662145Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T13:47:02.8662377Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T13:47:02.8662615Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T13:47:02.8662846Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T13:47:02.8663028Z }
