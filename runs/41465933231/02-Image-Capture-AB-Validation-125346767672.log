2026-11-02T14:52:47.7344344Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T14:52:47.7344755Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T14:52:47.7345031Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T14:52:47.7345231Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T14:52:47.7345405Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:52:47.7345573Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T14:52:47.7345770Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T14:52:47.7345932Z try {
2026-11-02T14:52:47.7346039Z   Set-Location "${drive}:\"
2026-11-02T14:52:47.7346263Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T14:52:47.7346576Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T14:52:47.7346814Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T14:52:47.7346992Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:52:47.7347198Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T14:52:47.7347436Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T14:52:47.7347607Z   }
2026-11-02T14:52:47.7347853Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T14:52:47.7348298Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T14:52:47.7348641Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T14:52:47.7348864Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T14:52:47.7349079Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T14:52:47.7349263Z   foreach ($relative in @(
2026-11-02T14:52:47.7349549Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T14:52:47.7349808Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T14:52:47.7350030Z   )) {
2026-11-02T14:52:47.7350239Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T14:52:47.7350535Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T14:52:47.7350727Z   }
2026-11-02T14:52:47.7350850Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:52:47.7351014Z     Set-Location "$scratch\$variant"
2026-11-02T14:52:47.7351334Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T14:52:47.7351673Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T14:52:47.7352039Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T14:52:47.7352365Z     $exitCode = $LASTEXITCODE
2026-11-02T14:52:47.7352651Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T14:52:47.7353057Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T14:52:47.7353326Z     Write-Host "$variant $($measurement[0])"
2026-11-02T14:52:47.7353469Z   }
2026-11-02T14:52:47.7354235Z   # Replace only the three pre-image-change production files in the
2026-11-02T14:52:47.7354482Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T14:52:47.7354670Z   Set-Location "${drive}:\"
2026-11-02T14:52:47.7354806Z   foreach ($relative in @(
2026-11-02T14:52:47.7354969Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T14:52:47.7355236Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T14:52:47.7355562Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T14:52:47.7355798Z   )) {
2026-11-02T14:52:47.7356007Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T14:52:47.7356297Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T14:52:47.7356479Z   }
2026-11-02T14:52:47.7356599Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:52:47.7356759Z     Set-Location "$scratch\$variant"
2026-11-02T14:52:47.7357105Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T14:52:47.7357451Z     $exitCode = $LASTEXITCODE
2026-11-02T14:52:47.7357749Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T14:52:47.7358177Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T14:52:47.7358456Z     Write-Host "$variant $($measurement[0])"
2026-11-02T14:52:47.7358594Z   }
2026-11-02T14:52:47.7358689Z } finally {
2026-11-02T14:52:47.7358802Z   Set-Location "${drive}:\"
2026-11-02T14:52:47.7358991Z   Remove-Item $scratch -Recurse -Force -ErrorAction SilentlyContinue
2026-11-02T14:52:47.7359194Z   Set-Location $env:RUNNER_TEMP
2026-11-02T14:52:47.7359365Z   Remove-Item $diagnostic -ErrorAction SilentlyContinue
2026-11-02T14:52:47.7359621Z   subst "${drive}:" /d
2026-11-02T14:52:47.7359736Z }
