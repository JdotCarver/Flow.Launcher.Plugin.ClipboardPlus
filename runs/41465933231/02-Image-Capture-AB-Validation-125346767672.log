2026-11-02T14:51:58.3674629Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:51:58.3674921Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:51:58.3675264Z # repository copies, so their absence is expected there and is
2026-11-02T14:51:58.3675464Z # reported rather than treated as a failure.
2026-11-02T14:51:58.3675624Z $testDirectory = "dev/tests"
2026-11-02T14:51:58.3675774Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:51:58.3676024Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:51:58.3676256Z   exit 0
2026-11-02T14:51:58.3676349Z }
2026-11-02T14:51:58.3676500Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:51:58.3676745Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:51:58.3677001Z # them and fail below the expected floor instead.
2026-11-02T14:51:58.3677286Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:51:58.3677564Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:51:58.3677807Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:51:58.3678054Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:51:58.3678298Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:51:58.3678485Z }
