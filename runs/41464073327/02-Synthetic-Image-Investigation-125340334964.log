2026-11-02T14:40:08.3441717Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:40:08.3442003Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:40:08.3442343Z # repository copies, so their absence is expected there and is
2026-11-02T14:40:08.3442544Z # reported rather than treated as a failure.
2026-11-02T14:40:08.3442696Z $testDirectory = "dev/tests"
2026-11-02T14:40:08.3442840Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:40:08.3443087Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:40:08.3443316Z   exit 0
2026-11-02T14:40:08.3443411Z }
2026-11-02T14:40:08.3443556Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:40:08.3443793Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:40:08.3444049Z # them and fail below the expected floor instead.
2026-11-02T14:40:08.3444333Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:40:08.3444607Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:40:08.3444833Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:40:08.3445074Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:40:08.3445305Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:40:08.3445493Z }
