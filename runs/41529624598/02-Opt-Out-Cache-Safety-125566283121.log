2026-11-02T21:36:13.5083125Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:36:13.5083587Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:36:13.5083896Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:36:13.5084140Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:36:13.5084314Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:36:13.5084482Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:36:13.5084660Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:36:13.5084821Z try {
2026-11-02T21:36:13.5084933Z   Set-Location "${drive}:\"
2026-11-02T21:36:13.5085157Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:36:13.5085617Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:36:13.5085860Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:36:13.5086065Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:36:13.5086272Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:36:13.5086509Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:36:13.5086687Z   }
2026-11-02T21:36:13.5086837Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:36:13.5087050Z   # cleanup integration in the before snapshot.
2026-11-02T21:36:13.5087368Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:36:13.5087844Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T21:36:13.5088339Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:36:13.5088690Z   # The historical ClipboardData lacks the newer origin marker.
