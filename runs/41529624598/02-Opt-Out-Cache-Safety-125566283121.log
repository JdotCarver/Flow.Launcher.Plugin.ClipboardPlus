2026-11-02T21:35:16.1158018Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:35:16.1158242Z # repository copies, so their absence is expected there and is
2026-11-02T21:35:16.1158434Z # reported rather than treated as a failure.
2026-11-02T21:35:16.1158582Z $testDirectory = "dev/tests"
2026-11-02T21:35:16.1158723Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:35:16.1158969Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T21:35:16.1159198Z   exit 0
2026-11-02T21:35:16.1159288Z }
2026-11-02T21:35:16.1159428Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:35:16.1159671Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:35:16.1159908Z # them and fail below the expected floor instead.
2026-11-02T21:35:16.1160184Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:35:16.1160457Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:35:16.1160674Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T21:35:16.1160909Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T21:35:16.1161138Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T21:35:16.1161317Z }
