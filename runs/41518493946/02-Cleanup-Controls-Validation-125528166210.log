2026-11-02T20:23:15.8963508Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:23:15.8963794Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:23:15.8964014Z # repository copies, so their absence is expected there and is
2026-11-02T20:23:15.8964207Z # reported rather than treated as a failure.
2026-11-02T20:23:15.8964360Z $testDirectory = "dev/tests"
2026-11-02T20:23:15.8964506Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:23:15.8964749Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:23:15.8964984Z   exit 0
2026-11-02T20:23:15.8965087Z }
2026-11-02T20:23:15.8965243Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:23:15.8965498Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:23:15.8965751Z # them and fail below the expected floor instead.
2026-11-02T20:23:15.8966051Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:23:15.8966329Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:23:15.8966560Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:23:15.8966809Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:23:15.8967058Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:23:15.8967249Z }
