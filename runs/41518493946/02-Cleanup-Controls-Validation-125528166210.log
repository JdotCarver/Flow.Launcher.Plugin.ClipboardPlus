2026-11-02T20:24:10.9542036Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:24:10.9542484Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:24:10.9542763Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:24:10.9542966Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:24:10.9543152Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:24:10.9543328Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:24:10.9543513Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:24:10.9543680Z try {
2026-11-02T20:24:10.9543796Z   Set-Location "${drive}:\"
2026-11-02T20:24:10.9544027Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:24:10.9544531Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:24:10.9544796Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:24:10.9544990Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:24:10.9545209Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:24:10.9545464Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:24:10.9545810Z   }
2026-11-02T20:24:10.9545971Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:24:10.9546184Z   # cleanup integration in the before snapshot.
2026-11-02T20:24:10.9546508Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:24:10.9546964Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:24:10.9547411Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:24:10.9547770Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:24:10.9547993Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T20:24:10.9548210Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T20:24:10.9548397Z   foreach ($relative in @(
2026-11-02T20:24:10.9548566Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T20:24:10.9548829Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T20:24:10.9549058Z   )) {
