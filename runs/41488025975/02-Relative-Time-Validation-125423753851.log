2026-11-02T17:08:37.4635872Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:08:37.4636269Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:08:37.4636526Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:08:37.4636725Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:08:37.4636894Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:08:37.4637062Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:08:37.4637234Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:08:37.4637411Z try {
2026-11-02T17:08:37.4637512Z   Set-Location "${drive}:\"
2026-11-02T17:08:37.4637733Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:08:37.4638051Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:08:37.4638282Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:08:37.4638456Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:08:37.4638716Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:08:37.4638949Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:08:37.4639115Z   }
2026-11-02T17:08:37.4639368Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:08:37.4639817Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:08:37.4640167Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:08:37.4640391Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:08:37.4640609Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:08:37.4640790Z   foreach ($relative in @(
2026-11-02T17:08:37.4640951Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:08:37.4641228Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:08:37.4641446Z   )) {
2026-11-02T17:08:37.4641648Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:08:37.4641940Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:08:37.4642127Z   }
2026-11-02T17:08:37.4642244Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:08:37.4643023Z     Set-Location "$scratch\$variant"
2026-11-02T17:08:37.4643350Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:08:37.4643695Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:08:37.4644060Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:08:37.4644390Z     $exitCode = $LASTEXITCODE
2026-11-02T17:08:37.4644678Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:08:37.4645093Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:08:37.4645376Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:08:37.4645518Z   }
2026-11-02T17:08:37.4646233Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:08:37.4646483Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:08:37.4646672Z   Set-Location "${drive}:\"
2026-11-02T17:08:37.4646802Z   foreach ($relative in @(
2026-11-02T17:08:37.4646965Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:08:37.4647246Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T17:08:37.4647578Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T17:08:37.4647796Z   )) {
2026-11-02T17:08:37.4647999Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:08:37.4648291Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T17:08:37.4648472Z   }
2026-11-02T17:08:37.4648586Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:08:37.4648745Z     Set-Location "$scratch\$variant"
2026-11-02T17:08:37.4649106Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T17:08:37.4649455Z     $exitCode = $LASTEXITCODE
2026-11-02T17:08:37.4649760Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:08:37.4650196Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T17:08:37.4650479Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:08:37.4650616Z   }
2026-11-02T17:08:37.4650757Z   # Pinning baseline differs only in the record implementation.
2026-11-02T17:08:37.4650937Z   Set-Location "${drive}:\"
2026-11-02T17:08:37.4651211Z   git show 537ba8c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs 2>> $diagnostic |
2026-11-02T17:08:37.4651667Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Clipboard\ClipboardData.cs"
2026-11-02T17:08:37.4652022Z   if ($LASTEXITCODE -ne 0) { throw "Pin baseline source unavailable" }
