2026-11-02T17:07:46.9628738Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:07:46.9629020Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:07:46.9629249Z # repository copies, so their absence is expected there and is
2026-11-02T17:07:46.9629447Z # reported rather than treated as a failure.
2026-11-02T17:07:46.9629604Z $testDirectory = "dev/tests"
2026-11-02T17:07:46.9629754Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:07:46.9630007Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:07:46.9630241Z   exit 0
2026-11-02T17:07:46.9630337Z }
2026-11-02T17:07:46.9630489Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:07:46.9630730Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:07:46.9630981Z # them and fail below the expected floor instead.
2026-11-02T17:07:46.9631266Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:07:46.9631548Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:07:46.9631768Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:07:46.9632011Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:07:46.9632247Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:07:46.9632438Z }
