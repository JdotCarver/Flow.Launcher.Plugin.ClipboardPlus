2026-11-02T17:08:37.4666842Z     $exitCode = $LASTEXITCODE
2026-11-02T17:08:37.4667174Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image pin 1024 noise: ms min/median/max=[0-9,./]+; median allocated=[0-9,.]+ MiB$' })
2026-11-02T17:08:37.4668044Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image pin A/B failed (details suppressed for privacy)" }
2026-11-02T17:08:37.4668325Z     Write-Host "$variant $($measurement[0])"
