2026-11-02T20:55:07.1693775Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:55:07.1694109Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:55:07.1694343Z # repository copies, so their absence is expected there and is
2026-11-02T20:55:07.1694548Z # reported rather than treated as a failure.
2026-11-02T20:55:07.1694707Z $testDirectory = "dev/tests"
2026-11-02T20:55:07.1694859Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:55:07.1695114Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:55:07.1695358Z   exit 0
2026-11-02T20:55:07.1695450Z }
2026-11-02T20:55:07.1695598Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:55:07.1695852Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:55:07.1696098Z # them and fail below the expected floor instead.
2026-11-02T20:55:07.1696384Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:55:07.1696671Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:55:07.1696897Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:55:07.1697266Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:55:07.1697586Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:55:07.1697788Z }
