2026-11-02T20:56:09.7174652Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:56:09.7175132Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:56:09.7175416Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:56:09.7175626Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:56:09.7175814Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:56:09.7175996Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:56:09.7176193Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:56:09.7176369Z try {
2026-11-02T20:56:09.7176483Z   Set-Location "${drive}:\"
2026-11-02T20:56:09.7176768Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:56:09.7177202Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:56:09.7177577Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:56:09.7177763Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:56:09.7177982Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:56:09.7178235Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:56:09.7178416Z   }
2026-11-02T20:56:09.7178579Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:56:09.7178790Z   # cleanup integration in the before snapshot.
2026-11-02T20:56:09.7179119Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:56:09.7179612Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T20:56:09.7180116Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:56:09.7180587Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:56:09.7181052Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
