2026-11-02T22:15:35.2449962Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:15:35.2450427Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T22:15:35.2450701Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T22:15:35.2450907Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T22:15:35.2451086Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:15:35.2451265Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T22:15:35.2451462Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T22:15:35.2451631Z try {
2026-11-02T22:15:35.2451745Z   Set-Location "${drive}:\"
2026-11-02T22:15:35.2451975Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T22:15:35.2452438Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T22:15:35.2452688Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T22:15:35.2452879Z   foreach ($variant in @('before', 'after')) {
2026-11-02T22:15:35.2453095Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T22:15:35.2453349Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T22:15:35.2453534Z   }
2026-11-02T22:15:35.2453697Z   # The historical caller is not partial and cannot include the new
2026-11-02T22:15:35.2453909Z   # cleanup integration in the before snapshot.
2026-11-02T22:15:35.2454236Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T22:15:35.2454734Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T22:15:35.2455228Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T22:15:35.2455583Z   # The historical ClipboardData lacks the newer origin marker.
