2026-11-02T22:14:35.7272081Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:14:35.7272305Z # repository copies, so their absence is expected there and is
2026-11-02T22:14:35.7272499Z # reported rather than treated as a failure.
2026-11-02T22:14:35.7272656Z $testDirectory = "dev/tests"
2026-11-02T22:14:35.7272805Z if (-not (Test-Path $testDirectory)) {
2026-11-02T22:14:35.7273050Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T22:14:35.7273277Z   exit 0
2026-11-02T22:14:35.7273368Z }
2026-11-02T22:14:35.7273511Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T22:14:35.7273751Z # renamed test directory would report green having run nothing. Count
2026-11-02T22:14:35.7273985Z # them and fail below the expected floor instead.
2026-11-02T22:14:35.7274268Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T22:14:35.7274539Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:14:35.7274756Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T22:14:35.7274995Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T22:14:35.7275229Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T22:14:35.7275410Z }
