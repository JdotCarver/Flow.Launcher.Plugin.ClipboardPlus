2026-11-02T20:34:17.9087020Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:34:17.9087451Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:34:17.9087717Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:34:17.9087916Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:34:17.9088101Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:34:17.9088270Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:34:17.9088470Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:34:17.9088633Z try {
2026-11-02T20:34:17.9088740Z   Set-Location "${drive}:\"
2026-11-02T20:34:17.9088967Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:34:17.9089280Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:34:17.9089530Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:34:17.9089710Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:34:17.9089912Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:34:17.9090151Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:34:17.9090468Z   }
2026-11-02T20:34:17.9090628Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:34:17.9090845Z   # cleanup integration in the before snapshot.
2026-11-02T20:34:17.9091178Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:34:17.9091678Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T20:34:17.9092170Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:34:17.9092635Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:34:17.9092994Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:34:17.9093226Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T20:34:17.9093453Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T20:34:17.9093643Z   foreach ($relative in @(
2026-11-02T20:34:17.9093821Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T20:34:17.9094105Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T20:34:17.9094344Z   )) {
2026-11-02T20:34:17.9094559Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
