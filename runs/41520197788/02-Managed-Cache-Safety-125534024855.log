2026-11-02T20:33:20.4009556Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:33:20.4009872Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:33:20.4010097Z # repository copies, so their absence is expected there and is
2026-11-02T20:33:20.4010297Z # reported rather than treated as a failure.
2026-11-02T20:33:20.4010454Z $testDirectory = "dev/tests"
2026-11-02T20:33:20.4010606Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:33:20.4010861Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:33:20.4011105Z   exit 0
2026-11-02T20:33:20.4011201Z }
2026-11-02T20:33:20.4011345Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:33:20.4011593Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:33:20.4011847Z # them and fail below the expected floor instead.
2026-11-02T20:33:20.4012134Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:33:20.4012415Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:33:20.4012638Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:33:20.4012881Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:33:20.4013122Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:33:20.4013307Z }
