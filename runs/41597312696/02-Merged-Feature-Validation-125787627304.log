2026-11-03T07:44:17.4309463Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-03T07:44:17.4309943Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-03T07:44:17.4310212Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-03T07:44:17.4310550Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-03T07:44:17.4310736Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-03T07:44:17.4310910Z $scratch = "${drive}:\.benchmark-ab"
2026-11-03T07:44:17.4311095Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-03T07:44:17.4311267Z try {
2026-11-03T07:44:17.4311378Z   Set-Location "${drive}:\"
2026-11-03T07:44:17.4311606Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-03T07:44:17.4311939Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-03T07:44:17.4312187Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-03T07:44:17.4312375Z   foreach ($variant in @('before', 'after')) {
2026-11-03T07:44:17.4312593Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-03T07:44:17.4312846Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-03T07:44:17.4313033Z   }
