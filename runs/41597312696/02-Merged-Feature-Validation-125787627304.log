2026-11-03T07:43:10.3553904Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-03T07:43:10.3554305Z # The tests live in dev/ and are not part of what a consumer
2026-11-03T07:43:10.3554523Z # repository copies, so their absence is expected there and is
2026-11-03T07:43:10.3554718Z # reported rather than treated as a failure.
2026-11-03T07:43:10.3554874Z $testDirectory = "dev/tests"
2026-11-03T07:43:10.3555016Z if (-not (Test-Path $testDirectory)) {
2026-11-03T07:43:10.3555263Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-03T07:43:10.3555494Z   exit 0
2026-11-03T07:43:10.3555586Z }
2026-11-03T07:43:10.3555731Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-03T07:43:10.3555968Z # renamed test directory would report green having run nothing. Count
2026-11-03T07:43:10.3556200Z # them and fail below the expected floor instead.
2026-11-03T07:43:10.3556484Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-03T07:43:10.3556753Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-03T07:43:10.3556968Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-03T07:43:10.3557206Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-03T07:43:10.3557442Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-03T07:43:10.3557622Z }
