2026-11-02T21:46:59.1492772Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:46:59.1492996Z # repository copies, so their absence is expected there and is
2026-11-02T21:46:59.1493190Z # reported rather than treated as a failure.
2026-11-02T21:46:59.1493343Z $testDirectory = "dev/tests"
2026-11-02T21:46:59.1493489Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:46:59.1493739Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T21:46:59.1493979Z   exit 0
2026-11-02T21:46:59.1494070Z }
2026-11-02T21:46:59.1494215Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:46:59.1494460Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:46:59.1494704Z # them and fail below the expected floor instead.
2026-11-02T21:46:59.1494990Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:46:59.1495267Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:46:59.1495485Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
