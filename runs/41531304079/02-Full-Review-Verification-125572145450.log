2026-11-02T21:47:57.1023699Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:47:57.1024179Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:47:57.1024458Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:47:57.1024668Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:47:57.1024851Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:47:57.1025028Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:47:57.1025215Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:47:57.1025384Z try {
2026-11-02T21:47:57.1025495Z   Set-Location "${drive}:\"
2026-11-02T21:47:57.1025728Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:47:57.1026202Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:47:57.1026454Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:47:57.1026639Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:47:57.1026852Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:47:57.1027107Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:47:57.1027287Z   }
2026-11-02T21:47:57.1027441Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:47:57.1027655Z   # cleanup integration in the before snapshot.
2026-11-02T21:47:57.1027993Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:47:57.1028519Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T21:47:57.1029031Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:47:57.1029399Z   # The historical ClipboardData lacks the newer origin marker.
