2026-11-02T21:04:33.7348692Z # repository copies, so their absence is expected there and is
2026-11-02T21:04:33.7348883Z # reported rather than treated as a failure.
2026-11-02T21:04:33.7349041Z $testDirectory = "dev/tests"
2026-11-02T21:04:33.7349185Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:04:33.7349427Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
