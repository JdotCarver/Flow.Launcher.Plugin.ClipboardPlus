2026-11-02T21:04:33.7349880Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:04:33.7350119Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:04:33.7350356Z # them and fail below the expected floor instead.
2026-11-02T21:04:33.7350622Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:04:33.7350880Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:04:33.7351093Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
