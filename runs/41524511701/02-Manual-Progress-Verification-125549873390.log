2026-11-02T21:05:35.5422987Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:05:35.5423458Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:05:35.5423715Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:05:35.5423917Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:05:35.5424091Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:05:35.5424262Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:05:35.5424443Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:05:35.5424603Z try {
2026-11-02T21:05:35.5424714Z   Set-Location "${drive}:\"
2026-11-02T21:05:35.5424943Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:05:35.5425259Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:05:35.5425631Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:05:35.5425839Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:05:35.5426049Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:05:35.5426297Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:05:35.5426470Z   }
2026-11-02T21:05:35.5426628Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:05:35.5426838Z   # cleanup integration in the before snapshot.
2026-11-02T21:05:35.5427161Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:05:35.5427634Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
