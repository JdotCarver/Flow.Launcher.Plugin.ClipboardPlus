2026-11-02T18:34:30.4954486Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:34:30.4954893Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:34:30.4955147Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T18:34:30.4955342Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T18:34:30.4955506Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:34:30.4955671Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T18:34:30.4955846Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T18:34:30.4956005Z try {
2026-11-02T18:34:30.4956113Z   Set-Location "${drive}:\"
2026-11-02T18:34:30.4956331Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T18:34:30.4956642Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T18:34:30.4956859Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T18:34:30.4957029Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:34:30.4957243Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T18:34:30.4957463Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T18:34:30.4957622Z   }
2026-11-02T18:34:30.4957864Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T18:34:30.4958287Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T18:34:30.4958610Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T18:34:30.4958820Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T18:34:30.4959023Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T18:34:30.4959186Z   foreach ($relative in @(
2026-11-02T18:34:30.4959341Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:34:30.4959587Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T18:34:30.4959790Z   )) {
2026-11-02T18:34:30.4959979Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T18:34:30.4960259Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T18:34:30.4960610Z   }
2026-11-02T18:34:30.4960720Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:34:30.4960872Z     Set-Location "$scratch\$variant"
2026-11-02T18:34:30.4961175Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T18:34:30.4961494Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T18:34:30.4961832Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T18:34:30.4962149Z     $exitCode = $LASTEXITCODE
2026-11-02T18:34:30.4962417Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T18:34:30.4962804Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T18:34:30.4963060Z     Write-Host "$variant $($measurement[0])"
2026-11-02T18:34:30.4963187Z   }
2026-11-02T18:34:30.4964008Z   # Replace only the three pre-image-change production files in the
2026-11-02T18:34:30.4964236Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T18:34:30.4964408Z   Set-Location "${drive}:\"
2026-11-02T18:34:30.4964528Z   foreach ($relative in @(
2026-11-02T18:34:30.4964678Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:34:30.4964921Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
