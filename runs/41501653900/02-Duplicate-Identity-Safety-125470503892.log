2026-11-02T18:33:34.7575385Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:33:34.7575666Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:33:34.7575870Z # repository copies, so their absence is expected there and is
2026-11-02T18:33:34.7576057Z # reported rather than treated as a failure.
2026-11-02T18:33:34.7576206Z $testDirectory = "dev/tests"
2026-11-02T18:33:34.7576342Z if (-not (Test-Path $testDirectory)) {
2026-11-02T18:33:34.7576578Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T18:33:34.7576795Z   exit 0
2026-11-02T18:33:34.7576880Z }
2026-11-02T18:33:34.7577017Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T18:33:34.7577236Z # renamed test directory would report green having run nothing. Count
2026-11-02T18:33:34.7577470Z # them and fail below the expected floor instead.
2026-11-02T18:33:34.7577733Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T18:33:34.7577996Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:33:34.7578204Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T18:33:34.7578437Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T18:33:34.7578656Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T18:33:34.7578836Z }
