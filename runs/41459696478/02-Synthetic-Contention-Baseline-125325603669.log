2026-11-02T14:13:07.6887448Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:13:07.6887748Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:13:07.6888098Z # repository copies, so their absence is expected there and is
2026-11-02T14:13:07.6888303Z # reported rather than treated as a failure.
2026-11-02T14:13:07.6888459Z $testDirectory = "dev/tests"
2026-11-02T14:13:07.6888608Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:13:07.6888861Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:13:07.6889097Z   exit 0
2026-11-02T14:13:07.6889194Z }
2026-11-02T14:13:07.6889345Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:13:07.6889584Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:13:07.6889821Z # them and fail below the expected floor instead.
2026-11-02T14:13:07.6890105Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:13:07.6890389Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:13:07.6890617Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:13:07.6890865Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:13:07.6891101Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:13:07.6891288Z }
