2026-11-02T14:19:20.4835937Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:19:20.4836234Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:19:20.4836575Z # repository copies, so their absence is expected there and is
2026-11-02T14:19:20.4836782Z # reported rather than treated as a failure.
2026-11-02T14:19:20.4836941Z $testDirectory = "dev/tests"
2026-11-02T14:19:20.4837095Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:19:20.4837349Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:19:20.4837586Z   exit 0
2026-11-02T14:19:20.4837687Z }
2026-11-02T14:19:20.4837838Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:19:20.4838078Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:19:20.4838325Z # them and fail below the expected floor instead.
2026-11-02T14:19:20.4838613Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:19:20.4838898Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:19:20.4839140Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:19:20.4839392Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:19:20.4839632Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:19:20.4839827Z }
