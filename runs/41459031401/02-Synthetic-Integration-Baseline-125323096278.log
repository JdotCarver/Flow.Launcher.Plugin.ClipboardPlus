2026-11-02T14:08:24.7886906Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:08:24.7887200Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:08:24.7887427Z # repository copies, so their absence is expected there and is
2026-11-02T14:08:24.7887632Z # reported rather than treated as a failure.
2026-11-02T14:08:24.7887788Z $testDirectory = "dev/tests"
2026-11-02T14:08:24.7887935Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:08:24.7888190Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:08:24.7888437Z   exit 0
2026-11-02T14:08:24.7888527Z }
2026-11-02T14:08:24.7888684Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:08:24.7888936Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:08:24.7889178Z # them and fail below the expected floor instead.
2026-11-02T14:08:24.7889471Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:08:24.7889759Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:08:24.7889991Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:08:24.7890246Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:08:24.7890490Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:08:24.7890679Z }
