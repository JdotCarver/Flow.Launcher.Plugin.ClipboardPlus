2026-11-02T21:26:33.4069372Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:26:33.4069828Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:26:33.4070106Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:26:33.4070310Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:26:33.4070485Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:26:33.4070655Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:26:33.4070841Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:26:33.4071007Z try {
2026-11-02T21:26:33.4071126Z   Set-Location "${drive}:\"
2026-11-02T21:26:33.4071355Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:26:33.4071692Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:26:33.4072055Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:26:33.4072245Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:26:33.4072456Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:26:33.4072702Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:26:33.4072878Z   }
2026-11-02T21:26:33.4073047Z   # The historical caller is not partial and cannot include the new
