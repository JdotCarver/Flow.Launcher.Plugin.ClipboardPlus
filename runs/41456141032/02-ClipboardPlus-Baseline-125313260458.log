2026-11-02T13:48:38.2794815Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:48:38.2795105Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:48:38.2795330Z # repository copies, so their absence is expected there and is
2026-11-02T13:48:38.2795531Z # reported rather than treated as a failure.
2026-11-02T13:48:38.2795691Z $testDirectory = "dev/tests"
2026-11-02T13:48:38.2795839Z if (-not (Test-Path $testDirectory)) {
2026-11-02T13:48:38.2796089Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T13:48:38.2796329Z   exit 0
2026-11-02T13:48:38.2796427Z }
2026-11-02T13:48:38.2796577Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T13:48:38.2796816Z # renamed test directory would report green having run nothing. Count
2026-11-02T13:48:38.2797073Z # them and fail below the expected floor instead.
2026-11-02T13:48:38.2797356Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T13:48:38.2797636Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T13:48:38.2797870Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T13:48:38.2798118Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T13:48:38.2798360Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T13:48:38.2798557Z }
