2026-11-02T18:37:29.1333597Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:37:29.1334065Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:37:29.1334357Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T18:37:29.1334586Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T18:37:29.1334783Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:37:29.1334973Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T18:37:29.1335170Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T18:37:29.1335351Z try {
2026-11-02T18:37:29.1335476Z   Set-Location "${drive}:\"
2026-11-02T18:37:29.1335745Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T18:37:29.1336104Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T18:37:29.1336350Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T18:37:29.1336551Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:37:29.1336774Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T18:37:29.1337039Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T18:37:29.1337225Z   }
2026-11-02T18:37:29.1337496Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T18:37:29.1337985Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T18:37:29.1338355Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T18:37:29.1338589Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T18:37:29.1338821Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T18:37:29.1339016Z   foreach ($relative in @(
2026-11-02T18:37:29.1339193Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:37:29.1339475Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T18:37:29.1339864Z   )) {
2026-11-02T18:37:29.1340084Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T18:37:29.1340402Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T18:37:29.1340617Z   }
2026-11-02T18:37:29.1340748Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:37:29.1340927Z     Set-Location "$scratch\$variant"
2026-11-02T18:37:29.1341267Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T18:37:29.1341630Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T18:37:29.1342010Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T18:37:29.1342362Z     $exitCode = $LASTEXITCODE
2026-11-02T18:37:29.1342665Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T18:37:29.1343095Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T18:37:29.1343388Z     Write-Host "$variant $($measurement[0])"
2026-11-02T18:37:29.1343560Z   }
2026-11-02T18:37:29.1344539Z   # Replace only the three pre-image-change production files in the
2026-11-02T18:37:29.1344822Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T18:37:29.1345021Z   Set-Location "${drive}:\"
