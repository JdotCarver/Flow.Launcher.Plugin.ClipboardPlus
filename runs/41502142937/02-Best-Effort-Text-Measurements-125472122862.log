2026-11-02T18:36:33.4571121Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:36:33.4571446Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:36:33.4571677Z # repository copies, so their absence is expected there and is
2026-11-02T18:36:33.4571882Z # reported rather than treated as a failure.
2026-11-02T18:36:33.4572043Z $testDirectory = "dev/tests"
2026-11-02T18:36:33.4572193Z if (-not (Test-Path $testDirectory)) {
2026-11-02T18:36:33.4572449Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T18:36:33.4572696Z   exit 0
2026-11-02T18:36:33.4572793Z }
2026-11-02T18:36:33.4572954Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T18:36:33.4573192Z # renamed test directory would report green having run nothing. Count
2026-11-02T18:36:33.4573444Z # them and fail below the expected floor instead.
2026-11-02T18:36:33.4573736Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T18:36:33.4574015Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:36:33.4574255Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T18:36:33.4574503Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T18:36:33.4574740Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T18:36:33.4574927Z }
