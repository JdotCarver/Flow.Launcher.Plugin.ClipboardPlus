2026-11-02T21:41:57.7911388Z }
2026-11-02T21:41:57.7911531Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:41:57.7911774Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:41:57.7912013Z # them and fail below the expected floor instead.
2026-11-02T21:41:57.7912298Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:41:57.7912578Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
