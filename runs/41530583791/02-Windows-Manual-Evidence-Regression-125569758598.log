2026-11-02T21:41:57.7910669Z $testDirectory = "dev/tests"
2026-11-02T21:41:57.7910809Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:41:57.7911060Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
