2026-11-02T21:43:45.1896887Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:43:45.1897193Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:43:45.1897418Z # repository copies, so their absence is expected there and is
2026-11-02T21:43:45.1897618Z # reported rather than treated as a failure.
2026-11-02T21:43:45.1897780Z $testDirectory = "dev/tests"
2026-11-02T21:43:45.1897927Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:43:45.1898173Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T21:43:45.1898399Z   exit 0
2026-11-02T21:43:45.1898490Z }
2026-11-02T21:43:45.1898642Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:43:45.1898879Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:43:45.1899115Z # them and fail below the expected floor instead.
2026-11-02T21:43:45.1899392Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
