2026-11-02T20:52:56.4256513Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:52:56.4257308Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:52:56.4257604Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:52:56.4257813Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:52:56.4257989Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:52:56.4258164Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:52:56.4258346Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:52:56.4258551Z try {
2026-11-02T20:52:56.4258872Z   Set-Location "${drive}:\"
2026-11-02T20:52:56.4259222Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:52:56.4259698Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:52:56.4260284Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:52:56.4260527Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:52:56.4260807Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:52:56.4261141Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:52:56.4261370Z   }
2026-11-02T20:52:56.4261566Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:52:56.4261875Z   # cleanup integration in the before snapshot.
2026-11-02T20:52:56.4262343Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:52:56.4263127Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T20:52:56.4263696Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:52:56.4264173Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:52:56.4264643Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:52:56.4265006Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:52:56.4265237Z   # The old database lacks the new image-reuse API, so use the
