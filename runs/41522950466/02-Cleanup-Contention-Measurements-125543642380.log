2026-11-02T20:51:52.6654409Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:51:52.6654711Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:51:52.6654940Z # repository copies, so their absence is expected there and is
2026-11-02T20:51:52.6655146Z # reported rather than treated as a failure.
2026-11-02T20:51:52.6655302Z $testDirectory = "dev/tests"
2026-11-02T20:51:52.6655450Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:51:52.6655744Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:51:52.6655983Z   exit 0
2026-11-02T20:51:52.6656077Z }
2026-11-02T20:51:52.6656229Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:51:52.6656487Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:51:52.6656732Z # them and fail below the expected floor instead.
2026-11-02T20:51:52.6657027Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:51:52.6657311Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:51:52.6657541Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:51:52.6657793Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:51:52.6658038Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:51:52.6658231Z }
