2026-11-02T18:40:36.0292678Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:40:36.0293115Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:40:36.0293386Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T18:40:36.0293596Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T18:40:36.0293789Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:40:36.0293965Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T18:40:36.0294148Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T18:40:36.0294323Z try {
2026-11-02T18:40:36.0294444Z   Set-Location "${drive}:\"
2026-11-02T18:40:36.0294675Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T18:40:36.0295014Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T18:40:36.0295257Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T18:40:36.0295446Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:40:36.0295657Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T18:40:36.0295903Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T18:40:36.0296080Z   }
2026-11-02T18:40:36.0296338Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T18:40:36.0296791Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T18:40:36.0297134Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T18:40:36.0297358Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T18:40:36.0297577Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T18:40:36.0297760Z   foreach ($relative in @(
2026-11-02T18:40:36.0297930Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:40:36.0298194Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T18:40:36.0298557Z   )) {
2026-11-02T18:40:36.0298768Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T18:40:36.0299092Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T18:40:36.0299297Z   }
2026-11-02T18:40:36.0299427Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:40:36.0299594Z     Set-Location "$scratch\$variant"
2026-11-02T18:40:36.0299923Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T18:40:36.0300276Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T18:40:36.0300647Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T18:40:36.0300982Z     $exitCode = $LASTEXITCODE
2026-11-02T18:40:36.0301273Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
