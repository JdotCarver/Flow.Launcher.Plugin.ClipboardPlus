2026-11-02T18:39:40.6995569Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:39:40.6995794Z # repository copies, so their absence is expected there and is
2026-11-02T18:39:40.6995997Z # reported rather than treated as a failure.
2026-11-02T18:39:40.6996156Z $testDirectory = "dev/tests"
2026-11-02T18:39:40.6996304Z if (-not (Test-Path $testDirectory)) {
2026-11-02T18:39:40.6996557Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T18:39:40.6996795Z   exit 0
2026-11-02T18:39:40.6996893Z }
2026-11-02T18:39:40.6997063Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T18:39:40.6997303Z # renamed test directory would report green having run nothing. Count
2026-11-02T18:39:40.6997553Z # them and fail below the expected floor instead.
2026-11-02T18:39:40.6997843Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T18:39:40.6998123Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:39:40.6998345Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T18:39:40.6998590Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T18:39:40.6998827Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T18:39:40.6999014Z }
