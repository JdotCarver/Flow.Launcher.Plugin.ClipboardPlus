2026-11-02T20:30:16.9215239Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:30:16.9215684Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:30:16.9215949Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:30:16.9216146Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:30:16.9216322Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:30:16.9216483Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:30:16.9216673Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:30:16.9216827Z try {
2026-11-02T20:30:16.9216924Z   Set-Location "${drive}:\"
2026-11-02T20:30:16.9217145Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:30:16.9217473Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:30:16.9217708Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:30:16.9217880Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:30:16.9218100Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:30:16.9218338Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:30:16.9218641Z   }
2026-11-02T20:30:16.9218792Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:30:16.9219000Z   # cleanup integration in the before snapshot.
2026-11-02T20:30:16.9219323Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:30:16.9219817Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T20:30:16.9220299Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:30:16.9220755Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:30:16.9221112Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:30:16.9221333Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T20:30:16.9221555Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T20:30:16.9231672Z   foreach ($relative in @(
2026-11-02T20:30:16.9231912Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T20:30:16.9232189Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T20:30:16.9232424Z   )) {
2026-11-02T20:30:16.9232637Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
