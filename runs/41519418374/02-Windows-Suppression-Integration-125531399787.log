2026-11-02T20:29:19.4317198Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:29:19.4317517Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:29:19.4317749Z # repository copies, so their absence is expected there and is
2026-11-02T20:29:19.4317948Z # reported rather than treated as a failure.
2026-11-02T20:29:19.4318101Z $testDirectory = "dev/tests"
2026-11-02T20:29:19.4318247Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:29:19.4318498Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:29:19.4318732Z   exit 0
2026-11-02T20:29:19.4318822Z }
2026-11-02T20:29:19.4318970Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:29:19.4319219Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:29:19.4319463Z # them and fail below the expected floor instead.
2026-11-02T20:29:19.4319748Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:29:19.4320030Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:29:19.4320248Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:29:19.4320494Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:29:19.4320733Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:29:19.4320922Z }
