2026-11-02T13:54:14.9024103Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:54:14.9024390Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:54:14.9024608Z # repository copies, so their absence is expected there and is
2026-11-02T13:54:14.9024799Z # reported rather than treated as a failure.
2026-11-02T13:54:14.9024954Z $testDirectory = "dev/tests"
2026-11-02T13:54:14.9025100Z if (-not (Test-Path $testDirectory)) {
2026-11-02T13:54:14.9025343Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T13:54:14.9025575Z   exit 0
2026-11-02T13:54:14.9025668Z }
2026-11-02T13:54:14.9025816Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T13:54:14.9026045Z # renamed test directory would report green having run nothing. Count
2026-11-02T13:54:14.9026276Z # them and fail below the expected floor instead.
2026-11-02T13:54:14.9026549Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T13:54:14.9026834Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T13:54:14.9027079Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T13:54:14.9027318Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T13:54:14.9027545Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T13:54:14.9027725Z }
