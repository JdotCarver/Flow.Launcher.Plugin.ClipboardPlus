2026-11-02T20:39:41.0853135Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:39:41.0853581Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:39:41.0853852Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:39:41.0854055Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:39:41.0854234Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:39:41.0854404Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:39:41.0854583Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:39:41.0854742Z try {
2026-11-02T20:39:41.0854864Z   Set-Location "${drive}:\"
2026-11-02T20:39:41.0855087Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:39:41.0855411Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:39:41.0855649Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:39:41.0855830Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:39:41.0856036Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:39:41.0856278Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:39:41.0856578Z   }
2026-11-02T20:39:41.0856728Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:39:41.0856941Z   # cleanup integration in the before snapshot.
2026-11-02T20:39:41.0857261Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:39:41.0857757Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T20:39:41.0858248Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:39:41.0858703Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:39:41.0859156Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:39:41.0859509Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:39:41.0859733Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T20:39:41.0859953Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T20:39:41.0860134Z   foreach ($relative in @(
2026-11-02T20:39:41.0860302Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T20:39:41.0860565Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
