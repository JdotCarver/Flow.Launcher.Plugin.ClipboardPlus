2026-11-02T20:38:44.2432980Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:38:44.2433305Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:38:44.2433571Z # repository copies, so their absence is expected there and is
2026-11-02T20:38:44.2433782Z # reported rather than treated as a failure.
2026-11-02T20:38:44.2433941Z $testDirectory = "dev/tests"
2026-11-02T20:38:44.2434088Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:38:44.2434340Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:38:44.2434573Z   exit 0
2026-11-02T20:38:44.2434668Z }
2026-11-02T20:38:44.2434816Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:38:44.2435064Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:38:44.2435298Z # them and fail below the expected floor instead.
2026-11-02T20:38:44.2435585Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:38:44.2435868Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:38:44.2436088Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:38:44.2436337Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:38:44.2436580Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:38:44.2436764Z }
