2026-11-02T21:50:31.7768692Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:50:31.7768913Z # repository copies, so their absence is expected there and is
2026-11-02T21:50:31.7769112Z # reported rather than treated as a failure.
2026-11-02T21:50:31.7769267Z $testDirectory = "dev/tests"
2026-11-02T21:50:31.7769410Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:50:31.7769663Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T21:50:31.7769900Z   exit 0
2026-11-02T21:50:31.7769987Z }
2026-11-02T21:50:31.7770129Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:50:31.7770375Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:50:31.7770612Z # them and fail below the expected floor instead.
2026-11-02T21:50:31.7770895Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:50:31.7771172Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:50:31.7771391Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T21:50:31.7771636Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T21:50:31.7771872Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T21:50:31.7772053Z }
