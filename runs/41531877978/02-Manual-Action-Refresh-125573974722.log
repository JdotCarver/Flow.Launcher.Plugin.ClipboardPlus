2026-11-02T21:51:29.9491672Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:51:29.9492140Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:51:29.9492457Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:51:29.9492705Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:51:29.9492923Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:51:29.9493130Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:51:29.9493345Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:51:29.9493536Z try {
2026-11-02T21:51:29.9493662Z   Set-Location "${drive}:\"
2026-11-02T21:51:29.9493911Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:51:29.9494383Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:51:29.9494638Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:51:29.9494823Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:51:29.9495035Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:51:29.9495286Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:51:29.9495469Z   }
2026-11-02T21:51:29.9495615Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:51:29.9495830Z   # cleanup integration in the before snapshot.
2026-11-02T21:51:29.9496169Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:51:29.9496700Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T21:51:29.9497221Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
