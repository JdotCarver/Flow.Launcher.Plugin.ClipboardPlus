2026-11-02T21:39:24.5996244Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:39:24.5996690Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:39:24.5996955Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:39:24.5997153Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:39:24.5997331Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:39:24.5997505Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:39:24.5997691Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:39:24.5997858Z try {
2026-11-02T21:39:24.5997970Z   Set-Location "${drive}:\"
2026-11-02T21:39:24.5998195Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:39:24.5998657Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:39:24.5998900Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:39:24.5999104Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:39:24.5999311Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:39:24.5999551Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:39:24.5999725Z   }
2026-11-02T21:39:24.5999884Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:39:24.6000084Z   # cleanup integration in the before snapshot.
2026-11-02T21:39:24.6000394Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:39:24.6000866Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T21:39:24.6001348Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:39:24.6001690Z   # The historical ClipboardData lacks the newer origin marker.
