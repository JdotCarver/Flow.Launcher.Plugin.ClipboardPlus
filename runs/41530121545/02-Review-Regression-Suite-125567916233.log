2026-11-02T21:38:26.0540882Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:38:26.0541169Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:38:26.0541387Z # repository copies, so their absence is expected there and is
2026-11-02T21:38:26.0541577Z # reported rather than treated as a failure.
2026-11-02T21:38:26.0541725Z $testDirectory = "dev/tests"
2026-11-02T21:38:26.0541868Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:38:26.0542108Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T21:38:26.0542337Z   exit 0
2026-11-02T21:38:26.0542428Z }
2026-11-02T21:38:26.0542570Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:38:26.0542810Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:38:26.0543046Z # them and fail below the expected floor instead.
2026-11-02T21:38:26.0543325Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:38:26.0543597Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:38:26.0543815Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T21:38:26.0544054Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T21:38:26.0544290Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T21:38:26.0544471Z }
