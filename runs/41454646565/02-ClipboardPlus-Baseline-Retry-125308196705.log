2026-11-02T13:38:13.6415051Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:38:13.6415383Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:38:13.6415608Z # repository copies, so their absence is expected there and is
2026-11-02T13:38:13.6415811Z # reported rather than treated as a failure.
2026-11-02T13:38:13.6415967Z $testDirectory = "dev/tests"
2026-11-02T13:38:13.6416113Z if (-not (Test-Path $testDirectory)) {
2026-11-02T13:38:13.6416358Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T13:38:13.6416587Z   exit 0
2026-11-02T13:38:13.6416680Z }
2026-11-02T13:38:13.6416833Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T13:38:13.6417063Z # renamed test directory would report green having run nothing. Count
2026-11-02T13:38:13.6417300Z # them and fail below the expected floor instead.
2026-11-02T13:38:13.6417583Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T13:38:13.6417857Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T13:38:13.6418083Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T13:38:13.6418323Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T13:38:13.6418558Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T13:38:13.6418740Z }
