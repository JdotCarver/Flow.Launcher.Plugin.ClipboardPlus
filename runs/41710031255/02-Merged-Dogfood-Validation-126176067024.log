2026-11-03T20:11:30.6185847Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-03T20:11:30.6186134Z # The tests live in dev/ and are not part of what a consumer
2026-11-03T20:11:30.6186357Z # repository copies, so their absence is expected there and is
2026-11-03T20:11:30.6186552Z # reported rather than treated as a failure.
2026-11-03T20:11:30.6186713Z $testDirectory = "dev/tests"
2026-11-03T20:11:30.6186859Z if (-not (Test-Path $testDirectory)) {
2026-11-03T20:11:30.6187111Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-03T20:11:30.6187344Z   exit 0
2026-11-03T20:11:30.6187446Z }
2026-11-03T20:11:30.6187591Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-03T20:11:30.6187824Z # renamed test directory would report green having run nothing. Count
2026-11-03T20:11:30.6188062Z # them and fail below the expected floor instead.
2026-11-03T20:11:30.6188342Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-03T20:11:30.6188620Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-03T20:11:30.6188840Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-03T20:11:30.6189085Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-03T20:11:30.6189324Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-03T20:11:30.6189508Z }
