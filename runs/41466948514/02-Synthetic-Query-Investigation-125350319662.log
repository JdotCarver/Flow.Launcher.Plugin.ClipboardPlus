2026-11-02T14:59:15.5163283Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T14:59:15.5163703Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T14:59:15.5163975Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T14:59:15.5164200Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T14:59:15.5164376Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:59:15.5164551Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T14:59:15.5164745Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T14:59:15.5164911Z try {
2026-11-02T14:59:15.5165022Z   Set-Location "${drive}:\"
2026-11-02T14:59:15.5165255Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T14:59:15.5165604Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T14:59:15.5165854Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T14:59:15.5166038Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:59:15.5166379Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T14:59:15.5166624Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T14:59:15.5166807Z   }
2026-11-02T14:59:15.5167065Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T14:59:15.5167518Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T14:59:15.5167877Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T14:59:15.5168108Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T14:59:15.5168328Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T14:59:15.5168514Z   foreach ($relative in @(
2026-11-02T14:59:15.5168680Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T14:59:15.5168943Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T14:59:15.5169166Z   )) {
2026-11-02T14:59:15.5169380Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T14:59:15.5169679Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T14:59:15.5169872Z   }
2026-11-02T14:59:15.5169990Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:59:15.5170151Z     Set-Location "$scratch\$variant"
2026-11-02T14:59:15.5170477Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T14:59:15.5170821Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T14:59:15.5171185Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T14:59:15.5171518Z     $exitCode = $LASTEXITCODE
2026-11-02T14:59:15.5171804Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T14:59:15.5172217Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T14:59:15.5172495Z     Write-Host "$variant $($measurement[0])"
2026-11-02T14:59:15.5172636Z   }
2026-11-02T14:59:15.5173416Z   # Replace only the three pre-image-change production files in the
2026-11-02T14:59:15.5173674Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T14:59:15.5173861Z   Set-Location "${drive}:\"
2026-11-02T14:59:15.5173999Z   foreach ($relative in @(
2026-11-02T14:59:15.5174177Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T14:59:15.5174442Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T14:59:15.5174771Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T14:59:15.5175001Z   )) {
2026-11-02T14:59:15.5175214Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T14:59:15.5175512Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T14:59:15.5175702Z   }
2026-11-02T14:59:15.5175825Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:59:15.5175990Z     Set-Location "$scratch\$variant"
2026-11-02T14:59:15.5176342Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T14:59:15.5176783Z     $exitCode = $LASTEXITCODE
2026-11-02T14:59:15.5177094Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T14:59:15.5177541Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T14:59:15.5177843Z     Write-Host "$variant $($measurement[0])"
2026-11-02T14:59:15.5177991Z   }
2026-11-02T14:59:15.5178092Z } finally {
2026-11-02T14:59:15.5178212Z   Set-Location "${drive}:\"
2026-11-02T14:59:15.5178408Z   Remove-Item $scratch -Recurse -Force -ErrorAction SilentlyContinue
2026-11-02T14:59:15.5178616Z   Set-Location $env:RUNNER_TEMP
2026-11-02T14:59:15.5178787Z   Remove-Item $diagnostic -ErrorAction SilentlyContinue
2026-11-02T14:59:15.5178963Z   subst "${drive}:" /d
2026-11-02T14:59:15.5179082Z }
