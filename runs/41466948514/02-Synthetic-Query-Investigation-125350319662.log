2026-11-02T14:58:24.8567866Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:58:24.8568199Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:58:24.8568747Z # repository copies, so their absence is expected there and is
2026-11-02T14:58:24.8568971Z # reported rather than treated as a failure.
2026-11-02T14:58:24.8569144Z $testDirectory = "dev/tests"
2026-11-02T14:58:24.8569307Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:58:24.8569594Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:58:24.8569858Z   exit 0
2026-11-02T14:58:24.8569956Z }
2026-11-02T14:58:24.8570118Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:58:24.8570395Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:58:24.8570656Z # them and fail below the expected floor instead.
2026-11-02T14:58:24.8570977Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:58:24.8571293Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:58:24.8571551Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:58:24.8571829Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:58:24.8572096Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:58:24.8572307Z }
