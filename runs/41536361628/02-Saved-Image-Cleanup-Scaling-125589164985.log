2026-11-02T22:20:29.5850464Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:20:29.5850745Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T22:20:29.5850964Z # repository copies, so their absence is expected there and is
2026-11-02T22:20:29.5851160Z # reported rather than treated as a failure.
2026-11-02T22:20:29.5851310Z $testDirectory = "dev/tests"
2026-11-02T22:20:29.5851453Z if (-not (Test-Path $testDirectory)) {
2026-11-02T22:20:29.5851698Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T22:20:29.5851929Z   exit 0
2026-11-02T22:20:29.5852018Z }
2026-11-02T22:20:29.5852161Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T22:20:29.5852405Z # renamed test directory would report green having run nothing. Count
2026-11-02T22:20:29.5852646Z # them and fail below the expected floor instead.
2026-11-02T22:20:29.5852927Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T22:20:29.5853201Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T22:20:29.5853416Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T22:20:29.5853653Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T22:20:29.5853889Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T22:20:29.5854070Z }
