2026-11-02T21:32:53.7102004Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:32:53.7102467Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:32:53.7102794Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:32:53.7103025Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:32:53.7103208Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:32:53.7103384Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:32:53.7103570Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:32:53.7103747Z try {
2026-11-02T21:32:53.7103863Z   Set-Location "${drive}:\"
2026-11-02T21:32:53.7104102Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:32:53.7104461Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:32:53.7104835Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:32:53.7105024Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:32:53.7105233Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:32:53.7105486Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:32:53.7105676Z   }
2026-11-02T21:32:53.7105838Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:32:53.7106055Z   # cleanup integration in the before snapshot.
2026-11-02T21:32:53.7106388Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:32:53.7106887Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T21:32:53.7107401Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:32:53.7107759Z   # The historical ClipboardData lacks the newer origin marker.
2026-11-02T21:32:53.7108142Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core.Test\WindowsOriginPinTests.cs" -ErrorAction SilentlyContinue
