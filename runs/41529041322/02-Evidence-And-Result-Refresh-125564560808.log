2026-11-02T21:31:55.6581050Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:31:55.6581334Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T21:31:55.6581554Z # repository copies, so their absence is expected there and is
2026-11-02T21:31:55.6581752Z # reported rather than treated as a failure.
2026-11-02T21:31:55.6581902Z $testDirectory = "dev/tests"
2026-11-02T21:31:55.6582044Z if (-not (Test-Path $testDirectory)) {
2026-11-02T21:31:55.6582294Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T21:31:55.6582533Z   exit 0
2026-11-02T21:31:55.6582624Z }
2026-11-02T21:31:55.6582768Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T21:31:55.6583012Z # renamed test directory would report green having run nothing. Count
2026-11-02T21:31:55.6583254Z # them and fail below the expected floor instead.
2026-11-02T21:31:55.6583546Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T21:31:55.6583828Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:31:55.6584047Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T21:31:55.6584294Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T21:31:55.6584536Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T21:31:55.6584724Z }
