2026-11-02T16:50:59.5224215Z   }
2026-11-02T16:50:59.5224337Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:50:59.5224504Z     Set-Location "$scratch\$variant"
2026-11-02T16:50:59.5224856Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T16:50:59.5225209Z     $exitCode = $LASTEXITCODE
2026-11-02T16:50:59.5225513Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T16:50:59.5226228Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T16:50:59.5226816Z     Write-Host "$variant $($measurement[0])"
2026-11-02T16:50:59.5227096Z   }
