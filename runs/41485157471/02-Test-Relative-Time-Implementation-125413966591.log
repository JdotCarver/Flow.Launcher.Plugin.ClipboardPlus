2026-11-02T16:50:59.5211575Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T16:50:59.5212013Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T16:50:59.5212293Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T16:50:59.5212630Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T16:50:59.5212809Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T16:50:59.5212985Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T16:50:59.5213169Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T16:50:59.5213331Z try {
2026-11-02T16:50:59.5213444Z   Set-Location "${drive}:\"
2026-11-02T16:50:59.5213675Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T16:50:59.5214003Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T16:50:59.5214247Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T16:50:59.5214426Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:50:59.5214632Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T16:50:59.5214877Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T16:50:59.5215060Z   }
2026-11-02T16:50:59.5215317Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T16:50:59.5215800Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T16:50:59.5216160Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T16:50:59.5216391Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T16:50:59.5216622Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T16:50:59.5216808Z   foreach ($relative in @(
2026-11-02T16:50:59.5216979Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T16:50:59.5217253Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T16:50:59.5217486Z   )) {
2026-11-02T16:50:59.5217697Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T16:50:59.5218008Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T16:50:59.5218206Z   }
2026-11-02T16:50:59.5218329Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:50:59.5218499Z     Set-Location "$scratch\$variant"
2026-11-02T16:50:59.5218836Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T16:50:59.5219193Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T16:50:59.5219570Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T16:50:59.5219914Z     $exitCode = $LASTEXITCODE
2026-11-02T16:50:59.5220210Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T16:50:59.5220643Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T16:50:59.5220926Z     Write-Host "$variant $($measurement[0])"
2026-11-02T16:50:59.5221076Z   }
2026-11-02T16:50:59.5221843Z   # Replace only the three pre-image-change production files in the
2026-11-02T16:50:59.5222106Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T16:50:59.5222299Z   Set-Location "${drive}:\"
2026-11-02T16:50:59.5222434Z   foreach ($relative in @(
2026-11-02T16:50:59.5222684Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
