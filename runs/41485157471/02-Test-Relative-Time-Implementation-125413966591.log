2026-11-02T16:50:11.3032202Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T16:50:11.3032633Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T16:50:11.3032860Z # repository copies, so their absence is expected there and is
2026-11-02T16:50:11.3033064Z # reported rather than treated as a failure.
2026-11-02T16:50:11.3033222Z $testDirectory = "dev/tests"
2026-11-02T16:50:11.3033371Z if (-not (Test-Path $testDirectory)) {
2026-11-02T16:50:11.3033626Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T16:50:11.3033870Z   exit 0
2026-11-02T16:50:11.3033966Z }
2026-11-02T16:50:11.3034114Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T16:50:11.3034355Z # renamed test directory would report green having run nothing. Count
2026-11-02T16:50:11.3034594Z # them and fail below the expected floor instead.
2026-11-02T16:50:11.3034880Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T16:50:11.3035165Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T16:50:11.3035389Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T16:50:11.3035637Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T16:50:11.3035882Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T16:50:11.3036073Z }
