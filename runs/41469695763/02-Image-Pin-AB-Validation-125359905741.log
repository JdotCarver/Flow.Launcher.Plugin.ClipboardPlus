2026-11-02T15:16:21.5076530Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T15:16:21.5076960Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T15:16:21.5077225Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T15:16:21.5077426Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T15:16:21.5077596Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T15:16:21.5077761Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T15:16:21.5077941Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T15:16:21.5078099Z try {
2026-11-02T15:16:21.5078201Z   Set-Location "${drive}:\"
2026-11-02T15:16:21.5078422Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T15:16:21.5078734Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T15:16:21.5079086Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T15:16:21.5079266Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:16:21.5079468Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T15:16:21.5079712Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T15:16:21.5079886Z   }
2026-11-02T15:16:21.5080138Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T15:16:21.5080594Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T15:16:21.5080945Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T15:16:21.5081164Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T15:16:21.5081377Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T15:16:21.5081558Z   foreach ($relative in @(
2026-11-02T15:16:21.5081719Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T15:16:21.5082001Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T15:16:21.5082224Z   )) {
2026-11-02T15:16:21.5082425Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T15:16:21.5082722Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T15:16:21.5082908Z   }
2026-11-02T15:16:21.5083022Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:16:21.5083175Z     Set-Location "$scratch\$variant"
2026-11-02T15:16:21.5083497Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T15:16:21.5083844Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T15:16:21.5084202Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T15:16:21.5084539Z     $exitCode = $LASTEXITCODE
2026-11-02T15:16:21.5084827Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T15:16:21.5085234Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T15:16:21.5085504Z     Write-Host "$variant $($measurement[0])"
2026-11-02T15:16:21.5085644Z   }
2026-11-02T15:16:21.5086443Z   # Replace only the three pre-image-change production files in the
2026-11-02T15:16:21.5086687Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T15:16:21.5086873Z   Set-Location "${drive}:\"
2026-11-02T15:16:21.5087003Z   foreach ($relative in @(
2026-11-02T15:16:21.5087160Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T15:16:21.5087424Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
