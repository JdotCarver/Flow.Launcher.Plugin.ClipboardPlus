2026-11-02T15:16:21.5087968Z   )) {
2026-11-02T15:16:21.5088168Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T15:16:21.5088455Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T15:16:21.5088634Z   }
2026-11-02T15:16:21.5088751Z   foreach ($variant in @('before', 'after')) {
2026-11-02T15:16:21.5088907Z     Set-Location "$scratch\$variant"
2026-11-02T15:16:21.5089333Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T15:16:21.5089676Z     $exitCode = $LASTEXITCODE
2026-11-02T15:16:21.5089968Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T15:16:21.5090396Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T15:16:21.5090676Z     Write-Host "$variant $($measurement[0])"
2026-11-02T15:16:21.5090812Z   }
2026-11-02T15:16:21.5090955Z   # Pinning baseline differs only in the record implementation.
2026-11-02T15:16:21.5091143Z   Set-Location "${drive}:\"
2026-11-02T15:16:21.5091420Z   git show 537ba8c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs 2>> $diagnostic |
