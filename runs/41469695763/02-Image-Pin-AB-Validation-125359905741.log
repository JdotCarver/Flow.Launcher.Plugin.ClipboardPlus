2026-11-02T15:15:29.5958635Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T15:15:29.5958928Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T15:15:29.5959275Z # repository copies, so their absence is expected there and is
2026-11-02T15:15:29.5959477Z # reported rather than treated as a failure.
2026-11-02T15:15:29.5959632Z $testDirectory = "dev/tests"
2026-11-02T15:15:29.5959780Z if (-not (Test-Path $testDirectory)) {
2026-11-02T15:15:29.5960032Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T15:15:29.5960267Z   exit 0
2026-11-02T15:15:29.5960367Z }
2026-11-02T15:15:29.5960510Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T15:15:29.5960742Z # renamed test directory would report green having run nothing. Count
2026-11-02T15:15:29.5960981Z # them and fail below the expected floor instead.
2026-11-02T15:15:29.5961260Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T15:15:29.5961541Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T15:15:29.5961764Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T15:15:29.5962008Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T15:15:29.5962246Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T15:15:29.5962434Z }
