2026-11-02T18:31:09.2212005Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:31:09.2212437Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:31:09.2212705Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T18:31:09.2212905Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T18:31:09.2213082Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:31:09.2213260Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T18:31:09.2213453Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T18:31:09.2213628Z try {
2026-11-02T18:31:09.2213739Z   Set-Location "${drive}:\"
2026-11-02T18:31:09.2213969Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T18:31:09.2214290Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T18:31:09.2214537Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T18:31:09.2214721Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:31:09.2214930Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T18:31:09.2215171Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T18:31:09.2215346Z   }
2026-11-02T18:31:09.2215602Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T18:31:09.2216059Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T18:31:09.2216407Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T18:31:09.2216634Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T18:31:09.2216854Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T18:31:09.2217035Z   foreach ($relative in @(
2026-11-02T18:31:09.2217203Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:31:09.2217472Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T18:31:09.2217701Z   )) {
2026-11-02T18:31:09.2218171Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T18:31:09.2218836Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T18:31:09.2219492Z   }
2026-11-02T18:31:09.2219717Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:31:09.2220020Z     Set-Location "$scratch\$variant"
2026-11-02T18:31:09.2220642Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T18:31:09.2221295Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T18:31:09.2221998Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T18:31:09.2222634Z     $exitCode = $LASTEXITCODE
2026-11-02T18:31:09.2223179Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T18:31:09.2223972Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T18:31:09.2224503Z     Write-Host "$variant $($measurement[0])"
2026-11-02T18:31:09.2224770Z   }
2026-11-02T18:31:09.2226379Z   # Replace only the three pre-image-change production files in the
2026-11-02T18:31:09.2226875Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T18:31:09.2227231Z   Set-Location "${drive}:\"
2026-11-02T18:31:09.2227473Z   foreach ($relative in @(
2026-11-02T18:31:09.2227779Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:31:09.2228364Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
