2026-11-02T18:30:14.0655479Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:30:14.0655785Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:30:14.0656014Z # repository copies, so their absence is expected there and is
2026-11-02T18:30:14.0656224Z # reported rather than treated as a failure.
2026-11-02T18:30:14.0656388Z $testDirectory = "dev/tests"
2026-11-02T18:30:14.0656548Z if (-not (Test-Path $testDirectory)) {
2026-11-02T18:30:14.0656806Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T18:30:14.0657042Z   exit 0
2026-11-02T18:30:14.0657141Z }
2026-11-02T18:30:14.0657292Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T18:30:14.0657538Z # renamed test directory would report green having run nothing. Count
2026-11-02T18:30:14.0657786Z # them and fail below the expected floor instead.
2026-11-02T18:30:14.0658076Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T18:30:14.0658359Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:30:14.0658607Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T18:30:14.0658853Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T18:30:14.0659095Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T18:30:14.0659283Z }
