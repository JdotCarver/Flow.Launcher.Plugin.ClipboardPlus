2026-11-02T14:29:55.0555401Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:29:55.0555566Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T14:29:55.0555740Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T14:29:55.0555903Z try {
2026-11-02T14:29:55.0556008Z   Set-Location "${drive}:\"
2026-11-02T14:29:55.0556231Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T14:29:55.0556549Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T14:29:55.0556784Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T14:29:55.0556964Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:29:55.0557170Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T14:29:55.0557403Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T14:29:55.0557580Z   }
2026-11-02T14:29:55.0557833Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T14:29:55.0558283Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T14:29:55.0558629Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T14:29:55.0558831Z   foreach ($variant in @('before', 'after')) {
2026-11-02T14:29:55.0558991Z     Set-Location "$scratch\$variant"
2026-11-02T14:29:55.0559311Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T14:29:55.0559662Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T14:29:55.0560039Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T14:29:55.0560371Z     $exitCode = $LASTEXITCODE
2026-11-02T14:29:55.0560661Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T14:29:55.0561076Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T14:29:55.0561350Z     Write-Host "$variant $($measurement[0])"
2026-11-02T14:29:55.0561492Z   }
2026-11-02T14:29:55.0561592Z } finally {
2026-11-02T14:29:55.0561701Z   Set-Location "${drive}:\"
2026-11-02T14:29:55.0561890Z   Remove-Item $scratch -Recurse -Force -ErrorAction SilentlyContinue
2026-11-02T14:29:55.0562087Z   Set-Location $env:RUNNER_TEMP
2026-11-02T14:29:55.0562258Z   Remove-Item $diagnostic -ErrorAction SilentlyContinue
2026-11-02T14:29:55.0562423Z   subst "${drive}:" /d
2026-11-02T14:29:55.0562535Z }
