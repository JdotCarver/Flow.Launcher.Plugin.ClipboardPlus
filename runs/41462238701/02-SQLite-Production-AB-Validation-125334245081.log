2026-11-02T14:29:09.0670434Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:29:09.0670720Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:29:09.0671066Z # repository copies, so their absence is expected there and is
2026-11-02T14:29:09.0671266Z # reported rather than treated as a failure.
2026-11-02T14:29:09.0671420Z $testDirectory = "dev/tests"
2026-11-02T14:29:09.0671566Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:29:09.0671813Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:29:09.0672045Z   exit 0
2026-11-02T14:29:09.0672138Z }
2026-11-02T14:29:09.0672286Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:29:09.0672520Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:29:09.0672750Z # them and fail below the expected floor instead.
2026-11-02T14:29:09.0673031Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:29:09.0673308Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:29:09.0673537Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:29:09.0673781Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:29:09.0674031Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:29:09.0674215Z }
