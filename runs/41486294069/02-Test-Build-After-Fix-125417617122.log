2026-11-02T16:57:31.8220600Z   }
2026-11-02T16:57:31.8220722Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:57:31.8220885Z     Set-Location "$scratch\$variant"
2026-11-02T16:57:31.8221248Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T16:57:31.8221605Z     $exitCode = $LASTEXITCODE
