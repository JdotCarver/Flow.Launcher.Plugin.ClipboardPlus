2026-11-02T16:56:44.3881105Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T16:56:44.3881410Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T16:56:44.3881642Z # repository copies, so their absence is expected there and is
2026-11-02T16:56:44.3881850Z # reported rather than treated as a failure.
2026-11-02T16:56:44.3882016Z $testDirectory = "dev/tests"
2026-11-02T16:56:44.3882169Z if (-not (Test-Path $testDirectory)) {
2026-11-02T16:56:44.3882430Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T16:56:44.3882675Z   exit 0
2026-11-02T16:56:44.3882774Z }
2026-11-02T16:56:44.3882933Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T16:56:44.3883184Z # renamed test directory would report green having run nothing. Count
2026-11-02T16:56:44.3883423Z # them and fail below the expected floor instead.
2026-11-02T16:56:44.3883719Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T16:56:44.3884011Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T16:56:44.3884244Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T16:56:44.3884496Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T16:56:44.3884736Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T16:56:44.3884938Z }
