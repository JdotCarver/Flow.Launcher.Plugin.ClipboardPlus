2026-11-02T16:57:31.8222364Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T16:57:31.8222655Z     Write-Host "$variant $($measurement[0])"
2026-11-02T16:57:31.8222796Z   }
2026-11-02T16:57:31.8222945Z   # Pinning baseline differs only in the record implementation.
2026-11-02T16:57:31.8223131Z   Set-Location "${drive}:\"
2026-11-02T16:57:31.8223412Z   git show 537ba8c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs 2>> $diagnostic |
