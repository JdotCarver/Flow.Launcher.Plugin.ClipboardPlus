2026-11-02T16:57:31.8207889Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T16:57:31.8208337Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T16:57:31.8208602Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T16:57:31.8208811Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T16:57:31.8208987Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T16:57:31.8209161Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T16:57:31.8209340Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T16:57:31.8209503Z try {
2026-11-02T16:57:31.8209610Z   Set-Location "${drive}:\"
2026-11-02T16:57:31.8209842Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T16:57:31.8210166Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T16:57:31.8210406Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T16:57:31.8210591Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:57:31.8210801Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T16:57:31.8211044Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T16:57:31.8211223Z   }
2026-11-02T16:57:31.8211482Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T16:57:31.8211947Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T16:57:31.8212300Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T16:57:31.8212525Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T16:57:31.8212745Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T16:57:31.8212928Z   foreach ($relative in @(
2026-11-02T16:57:31.8213093Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T16:57:31.8213361Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T16:57:31.8213947Z   )) {
2026-11-02T16:57:31.8214163Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T16:57:31.8214475Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T16:57:31.8214675Z   }
2026-11-02T16:57:31.8214795Z   foreach ($variant in @('before', 'after')) {
2026-11-02T16:57:31.8214961Z     Set-Location "$scratch\$variant"
2026-11-02T16:57:31.8215304Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T16:57:31.8215677Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T16:57:31.8216048Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T16:57:31.8216394Z     $exitCode = $LASTEXITCODE
2026-11-02T16:57:31.8216692Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T16:57:31.8217128Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T16:57:31.8217423Z     Write-Host "$variant $($measurement[0])"
2026-11-02T16:57:31.8217568Z   }
2026-11-02T16:57:31.8218301Z   # Replace only the three pre-image-change production files in the
2026-11-02T16:57:31.8218552Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T16:57:31.8218743Z   Set-Location "${drive}:\"
2026-11-02T16:57:31.8218879Z   foreach ($relative in @(
2026-11-02T16:57:31.8219048Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
