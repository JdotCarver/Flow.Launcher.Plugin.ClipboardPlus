2026-11-02T18:17:32.0342988Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:17:32.0343293Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T18:17:32.0343527Z # repository copies, so their absence is expected there and is
2026-11-02T18:17:32.0343736Z # reported rather than treated as a failure.
2026-11-02T18:17:32.0343895Z $testDirectory = "dev/tests"
2026-11-02T18:17:32.0344045Z if (-not (Test-Path $testDirectory)) {
2026-11-02T18:17:32.0344306Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T18:17:32.0344551Z   exit 0
2026-11-02T18:17:32.0344646Z }
2026-11-02T18:17:32.0344793Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T18:17:32.0345048Z # renamed test directory would report green having run nothing. Count
2026-11-02T18:17:32.0345300Z # them and fail below the expected floor instead.
2026-11-02T18:17:32.0345594Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T18:17:32.0345886Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:17:32.0346132Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T18:17:32.0346389Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T18:17:32.0346639Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T18:17:32.0346827Z }
