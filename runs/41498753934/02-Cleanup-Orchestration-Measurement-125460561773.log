2026-11-02T18:18:29.3644323Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:18:29.3644754Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T18:18:29.3645033Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T18:18:29.3645238Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T18:18:29.3645412Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T18:18:29.3645592Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T18:18:29.3645781Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T18:18:29.3645944Z try {
2026-11-02T18:18:29.3646049Z   Set-Location "${drive}:\"
2026-11-02T18:18:29.3646285Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T18:18:29.3646613Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T18:18:29.3646855Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T18:18:29.3647039Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:18:29.3647264Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T18:18:29.3647509Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T18:18:29.3647683Z   }
2026-11-02T18:18:29.3647943Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T18:18:29.3648411Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T18:18:29.3648763Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T18:18:29.3649001Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T18:18:29.3649222Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T18:18:29.3649450Z   foreach ($relative in @(
2026-11-02T18:18:29.3649616Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T18:18:29.3649883Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T18:18:29.3650114Z   )) {
2026-11-02T18:18:29.3650327Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T18:18:29.3650772Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T18:18:29.3650968Z   }
2026-11-02T18:18:29.3651089Z   foreach ($variant in @('before', 'after')) {
2026-11-02T18:18:29.3651256Z     Set-Location "$scratch\$variant"
2026-11-02T18:18:29.3651595Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T18:18:29.3651959Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T18:18:29.3652342Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T18:18:29.3652687Z     $exitCode = $LASTEXITCODE
2026-11-02T18:18:29.3652982Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T18:18:29.3653412Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T18:18:29.3653691Z     Write-Host "$variant $($measurement[0])"
2026-11-02T18:18:29.3653834Z   }
2026-11-02T18:18:29.3654656Z   # Replace only the three pre-image-change production files in the
