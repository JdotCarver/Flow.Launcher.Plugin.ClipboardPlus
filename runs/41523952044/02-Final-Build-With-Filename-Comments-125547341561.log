2026-11-02T20:59:07.1028973Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:59:07.1029253Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:59:07.1029470Z # repository copies, so their absence is expected there and is
2026-11-02T20:59:07.1029662Z # reported rather than treated as a failure.
2026-11-02T20:59:07.1029810Z $testDirectory = "dev/tests"
2026-11-02T20:59:07.1029951Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:59:07.1030195Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:59:07.1030425Z   exit 0
2026-11-02T20:59:07.1030513Z }
2026-11-02T20:59:07.1030651Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:59:07.1030888Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:59:07.1031125Z # them and fail below the expected floor instead.
2026-11-02T20:59:07.1031401Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:59:07.1031673Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:59:07.1031886Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:59:07.1032124Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:59:07.1032358Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:59:07.1032535Z }
