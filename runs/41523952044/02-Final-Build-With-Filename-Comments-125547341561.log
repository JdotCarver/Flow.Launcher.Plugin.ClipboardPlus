2026-11-02T21:00:07.9861932Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:00:07.9862451Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T21:00:07.9862734Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T21:00:07.9862950Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T21:00:07.9863139Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T21:00:07.9863320Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T21:00:07.9863514Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T21:00:07.9863687Z try {
2026-11-02T21:00:07.9863804Z   Set-Location "${drive}:\"
2026-11-02T21:00:07.9864058Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T21:00:07.9864402Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T21:00:07.9864792Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T21:00:07.9864986Z   foreach ($variant in @('before', 'after')) {
2026-11-02T21:00:07.9865202Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T21:00:07.9865667Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T21:00:07.9865914Z   }
2026-11-02T21:00:07.9866082Z   # The historical caller is not partial and cannot include the new
2026-11-02T21:00:07.9866309Z   # cleanup integration in the before snapshot.
2026-11-02T21:00:07.9866665Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:00:07.9867194Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.WindowsSuppression.cs" -ErrorAction SilentlyContinue
2026-11-02T21:00:07.9867722Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.CacheCleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T21:00:07.9868205Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T21:00:07.9868676Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
