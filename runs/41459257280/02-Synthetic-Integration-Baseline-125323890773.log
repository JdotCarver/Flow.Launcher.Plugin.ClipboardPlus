2026-11-02T14:09:49.1752925Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:09:49.1753214Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T14:09:49.1753432Z # repository copies, so their absence is expected there and is
2026-11-02T14:09:49.1753627Z # reported rather than treated as a failure.
2026-11-02T14:09:49.1753780Z $testDirectory = "dev/tests"
2026-11-02T14:09:49.1753925Z if (-not (Test-Path $testDirectory)) {
2026-11-02T14:09:49.1754171Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T14:09:49.1754423Z   exit 0
2026-11-02T14:09:49.1754526Z }
2026-11-02T14:09:49.1754676Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T14:09:49.1754922Z # renamed test directory would report green having run nothing. Count
2026-11-02T14:09:49.1755161Z # them and fail below the expected floor instead.
2026-11-02T14:09:49.1755437Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T14:09:49.1755703Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T14:09:49.1755928Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T14:09:49.1756167Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T14:09:49.1756403Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T14:09:49.1756589Z }
