2026-11-02T20:14:32.0536409Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:14:32.0536698Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:14:32.0536924Z # repository copies, so their absence is expected there and is
2026-11-02T20:14:32.0537123Z # reported rather than treated as a failure.
2026-11-02T20:14:32.0537275Z $testDirectory = "dev/tests"
2026-11-02T20:14:32.0537423Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:14:32.0537678Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:14:32.0537914Z   exit 0
2026-11-02T20:14:32.0538006Z }
2026-11-02T20:14:32.0538155Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:14:32.0538404Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:14:32.0538650Z # them and fail below the expected floor instead.
2026-11-02T20:14:32.0538932Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:14:32.0539219Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:14:32.0539442Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:14:32.0539691Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:14:32.0539932Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:14:32.0540118Z }
