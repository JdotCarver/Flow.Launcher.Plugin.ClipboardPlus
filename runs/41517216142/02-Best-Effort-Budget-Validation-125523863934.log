2026-11-02T20:15:26.8370236Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:15:26.8370703Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:15:26.8371000Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:15:26.8371216Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:15:26.8371398Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:15:26.8371585Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:15:26.8371770Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:15:26.8371939Z try {
2026-11-02T20:15:26.8372046Z   Set-Location "${drive}:\"
2026-11-02T20:15:26.8372276Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:15:26.8372611Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:15:26.8372850Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:15:26.8373032Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:15:26.8373237Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:15:26.8373479Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:15:26.8373653Z   }
2026-11-02T20:15:26.8373910Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:15:26.8374494Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:15:26.8374849Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:15:26.8375070Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T20:15:26.8375289Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T20:15:26.8375466Z   foreach ($relative in @(
2026-11-02T20:15:26.8375628Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T20:15:26.8375914Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T20:15:26.8376136Z   )) {
2026-11-02T20:15:26.8376341Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T20:15:26.8376641Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T20:15:26.8376830Z   }
2026-11-02T20:15:26.8376944Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:15:26.8377103Z     Set-Location "$scratch\$variant"
