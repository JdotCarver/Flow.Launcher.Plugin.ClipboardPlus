2026-11-02T17:52:53.9773805Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:52:53.9774159Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:52:53.9774420Z # repository copies, so their absence is expected there and is
2026-11-02T17:52:53.9774656Z # reported rather than treated as a failure.
2026-11-02T17:52:53.9774821Z $testDirectory = "dev/tests"
2026-11-02T17:52:53.9774974Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:52:53.9775235Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:52:53.9775482Z   exit 0
2026-11-02T17:52:53.9775588Z }
2026-11-02T17:52:53.9775739Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:52:53.9775994Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:52:53.9776250Z # them and fail below the expected floor instead.
2026-11-02T17:52:53.9776559Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:52:53.9776848Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:52:53.9777078Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:52:53.9777339Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:52:53.9777590Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:52:53.9777782Z }
