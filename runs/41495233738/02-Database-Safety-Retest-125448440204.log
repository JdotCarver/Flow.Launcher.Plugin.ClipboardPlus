2026-11-02T17:53:46.5508970Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:53:46.5509394Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:53:46.5509675Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:53:46.5509879Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:53:46.5510060Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:53:46.5510231Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:53:46.5510414Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:53:46.5510577Z try {
2026-11-02T17:53:46.5510680Z   Set-Location "${drive}:\"
2026-11-02T17:53:46.5510904Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:53:46.5511235Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:53:46.5511472Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:53:46.5511659Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:53:46.5511862Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:53:46.5512108Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:53:46.5512286Z   }
2026-11-02T17:53:46.5512549Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:53:46.5513011Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:53:46.5513364Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:53:46.5513591Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:53:46.5513811Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:53:46.5513994Z   foreach ($relative in @(
2026-11-02T17:53:46.5514158Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:53:46.5514425Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:53:46.5514650Z   )) {
2026-11-02T17:53:46.5514856Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:53:46.5515164Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:53:46.5515360Z   }
2026-11-02T17:53:46.5515475Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:53:46.5515635Z     Set-Location "$scratch\$variant"
2026-11-02T17:53:46.5515970Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:53:46.5516318Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:53:46.5516828Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:53:46.5517164Z     $exitCode = $LASTEXITCODE
2026-11-02T17:53:46.5517457Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:53:46.5517879Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:53:46.5518159Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:53:46.5518303Z   }
2026-11-02T17:53:46.5519129Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:53:46.5519380Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:53:46.5519576Z   Set-Location "${drive}:\"
2026-11-02T17:53:46.5519712Z   foreach ($relative in @(
2026-11-02T17:53:46.5519877Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:53:46.5520148Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T17:53:46.5520484Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T17:53:46.5520710Z   )) {
2026-11-02T17:53:46.5520920Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:53:46.5521219Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T17:53:46.5521418Z   }
2026-11-02T17:53:46.5521542Z   foreach ($variant in @('before', 'after')) {
