2026-11-02T20:18:34.0848955Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:18:34.0849403Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T20:18:34.0849682Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T20:18:34.0849888Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T20:18:34.0850080Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:18:34.0850255Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T20:18:34.0850442Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T20:18:34.0850632Z try {
2026-11-02T20:18:34.0850745Z   Set-Location "${drive}:\"
2026-11-02T20:18:34.0850976Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T20:18:34.0851309Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T20:18:34.0851561Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T20:18:34.0851748Z   foreach ($variant in @('before', 'after')) {
2026-11-02T20:18:34.0851955Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T20:18:34.0852204Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T20:18:34.0852518Z   }
2026-11-02T20:18:34.0852675Z   # The historical caller is not partial and cannot include the new
2026-11-02T20:18:34.0852884Z   # cleanup integration in the before snapshot.
2026-11-02T20:18:34.0853212Z   Remove-Item "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus\ClipboardPlus.Cleanup.cs" -ErrorAction SilentlyContinue
2026-11-02T20:18:34.0853670Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T20:18:34.0854124Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T20:18:34.0854483Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T20:18:34.0854707Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T20:18:34.0854930Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T20:18:34.0855141Z   foreach ($relative in @(
2026-11-02T20:18:34.0855313Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T20:18:34.0855583Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T20:18:34.0855818Z   )) {
2026-11-02T20:18:34.0856032Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T20:18:34.0856361Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T20:18:34.0856562Z   }
2026-11-02T20:18:34.0856690Z   foreach ($variant in @('before', 'after')) {
