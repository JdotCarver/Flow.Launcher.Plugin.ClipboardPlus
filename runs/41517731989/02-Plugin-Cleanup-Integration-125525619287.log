2026-11-02T20:17:40.8692442Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:17:40.8692729Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T20:17:40.8692946Z # repository copies, so their absence is expected there and is
2026-11-02T20:17:40.8693140Z # reported rather than treated as a failure.
2026-11-02T20:17:40.8693298Z $testDirectory = "dev/tests"
2026-11-02T20:17:40.8693442Z if (-not (Test-Path $testDirectory)) {
2026-11-02T20:17:40.8693686Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T20:17:40.8693914Z   exit 0
2026-11-02T20:17:40.8694006Z }
2026-11-02T20:17:40.8694150Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T20:17:40.8694387Z # renamed test directory would report green having run nothing. Count
2026-11-02T20:17:40.8694621Z # them and fail below the expected floor instead.
2026-11-02T20:17:40.8694896Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T20:17:40.8695187Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T20:17:40.8695404Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T20:17:40.8695645Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T20:17:40.8695879Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T20:17:40.8696061Z }
