2026-11-02T13:23:45.4711546Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:23:45.4712139Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T13:23:45.4712587Z # repository copies, so their absence is expected there and is
2026-11-02T13:23:45.4712996Z # reported rather than treated as a failure.
2026-11-02T13:23:45.4713295Z $testDirectory = "dev/tests"
2026-11-02T13:23:45.4713582Z if (-not (Test-Path $testDirectory)) {
2026-11-02T13:23:45.4714083Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T13:23:45.4714539Z   exit 0
2026-11-02T13:23:45.4714717Z }
2026-11-02T13:23:45.4715010Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T13:23:45.4715500Z # renamed test directory would report green having run nothing. Count
2026-11-02T13:23:45.4716468Z # them and fail below the expected floor instead.
2026-11-02T13:23:45.4717046Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T13:23:45.4717612Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T13:23:45.4718059Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T13:23:45.4718537Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T13:23:45.4719013Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T13:23:45.4719399Z }
