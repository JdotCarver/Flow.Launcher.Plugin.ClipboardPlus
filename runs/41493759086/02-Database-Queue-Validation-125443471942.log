2026-11-02T17:43:36.3820559Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:43:36.3820851Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:43:36.3821071Z # repository copies, so their absence is expected there and is
2026-11-02T17:43:36.3821272Z # reported rather than treated as a failure.
2026-11-02T17:43:36.3821429Z $testDirectory = "dev/tests"
2026-11-02T17:43:36.3821577Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:43:36.3821824Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:43:36.3822062Z   exit 0
2026-11-02T17:43:36.3822156Z }
2026-11-02T17:43:36.3822302Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:43:36.3822547Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:43:36.3822782Z # them and fail below the expected floor instead.
2026-11-02T17:43:36.3823064Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:43:36.3823342Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:43:36.3823566Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:43:36.3823813Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:43:36.3824055Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:43:36.3824243Z }
