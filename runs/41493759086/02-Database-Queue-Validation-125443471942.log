2026-11-02T17:44:29.2027346Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:44:29.2027942Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:44:29.2028244Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:44:29.2028471Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:44:29.2028664Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:44:29.2028859Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:44:29.2029057Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:44:29.2029239Z try {
2026-11-02T17:44:29.2029353Z   Set-Location "${drive}:\"
2026-11-02T17:44:29.2029604Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:44:29.2029973Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:44:29.2030247Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:44:29.2030449Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:44:29.2030676Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:44:29.2030944Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:44:29.2031144Z   }
2026-11-02T17:44:29.2031430Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:44:29.2031954Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:44:29.2032358Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:44:29.2032611Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:44:29.2032856Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:44:29.2033071Z   foreach ($relative in @(
2026-11-02T17:44:29.2033249Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:44:29.2033548Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:44:29.2033801Z   )) {
2026-11-02T17:44:29.2034032Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:44:29.2034375Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:44:29.2034614Z   }
2026-11-02T17:44:29.2034741Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:44:29.2034917Z     Set-Location "$scratch\$variant"
2026-11-02T17:44:29.2035294Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:44:29.2035697Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:44:29.2036117Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:44:29.2036510Z     $exitCode = $LASTEXITCODE
2026-11-02T17:44:29.2036844Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:44:29.2037324Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:44:29.2037640Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:44:29.2037794Z   }
2026-11-02T17:44:29.2038591Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:44:29.2038874Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:44:29.2039166Z   Set-Location "${drive}:\"
2026-11-02T17:44:29.2039310Z   foreach ($relative in @(
2026-11-02T17:44:29.2039491Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:44:29.2039789Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T17:44:29.2040159Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T17:44:29.2040414Z   )) {
2026-11-02T17:44:29.2040646Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:44:29.2041019Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T17:44:29.2041318Z   }
2026-11-02T17:44:29.2041503Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:44:29.2041799Z     Set-Location "$scratch\$variant"
2026-11-02T17:44:29.2042260Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T17:44:29.2042732Z     $exitCode = $LASTEXITCODE
2026-11-02T17:44:29.2043132Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:44:29.2043683Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T17:44:29.2044072Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:44:29.2050810Z   }
2026-11-02T17:44:29.2051023Z   # Pinning baseline differs only in the record implementation.
2026-11-02T17:44:29.2051255Z   Set-Location "${drive}:\"
