2026-11-02T17:01:20.2153263Z ##[group]Run $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:01:20.2153671Z $drive = @('Z','Y','X','W','V') | Where-Object { -not (Test-Path "${_}:\") } | Select-Object -First 1
2026-11-02T17:01:20.2153943Z if (-not $drive) { throw "No temporary drive letter available" }
2026-11-02T17:01:20.2154149Z subst "${drive}:" "$env:GITHUB_WORKSPACE"
2026-11-02T17:01:20.2154322Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:01:20.2154486Z $scratch = "${drive}:\.benchmark-ab"
2026-11-02T17:01:20.2154661Z $diagnostic = "$env:RUNNER_TEMP\clipboardplus-ab.log"
2026-11-02T17:01:20.2154821Z try {
2026-11-02T17:01:20.2154920Z   Set-Location "${drive}:\"
2026-11-02T17:01:20.2155145Z   New-Item -ItemType Directory -Path "$scratch\before", "$scratch\after" -Force | Out-Null
2026-11-02T17:01:20.2155475Z   git archive --format=tar --output="$scratch\snapshot.tar" HEAD *>> $diagnostic
2026-11-02T17:01:20.2155719Z   if ($LASTEXITCODE -ne 0) { throw "Snapshot failed" }
2026-11-02T17:01:20.2155903Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:01:20.2156111Z     tar -xf "$scratch\snapshot.tar" -C "$scratch\$variant" *>> $diagnostic
2026-11-02T17:01:20.2156360Z     if ($LASTEXITCODE -ne 0) { throw "Snapshot extraction failed" }
2026-11-02T17:01:20.2156540Z   }
2026-11-02T17:01:20.2156795Z   git show 077bf9c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs 2>> $diagnostic |
2026-11-02T17:01:20.2157260Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Database\SqliteDatabase.cs"
2026-11-02T17:01:20.2157623Z   if ($LASTEXITCODE -ne 0) { throw "Baseline source unavailable" }
2026-11-02T17:01:20.2157850Z   # The old database lacks the new image-reuse API, so use the
2026-11-02T17:01:20.2158070Z   # pre-image versions of its callers in the bulk baseline too.
2026-11-02T17:01:20.2158250Z   foreach ($relative in @(
2026-11-02T17:01:20.2158414Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:01:20.2158694Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs'
2026-11-02T17:01:20.2159055Z   )) {
2026-11-02T17:01:20.2159269Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:01:20.2159576Z     if ($LASTEXITCODE -ne 0) { throw "Bulk baseline caller source unavailable" }
2026-11-02T17:01:20.2159765Z   }
2026-11-02T17:01:20.2159885Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:01:20.2160044Z     Set-Location "$scratch\$variant"
2026-11-02T17:01:20.2160375Z     dotnet restore tools/performance-baseline/PerformanceBaseline.csproj --source https://api.nuget.org/v3/index.json *> $diagnostic
2026-11-02T17:01:20.2160722Z     if ($LASTEXITCODE -ne 0) { throw "A/B restore failed" }
2026-11-02T17:01:20.2161092Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --bulk-only *> $diagnostic
2026-11-02T17:01:20.2161427Z     $exitCode = $LASTEXITCODE
2026-11-02T17:01:20.2161717Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual bulk insert 500 records: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:01:20.2162137Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "A/B benchmark failed (details suppressed for privacy)" }
2026-11-02T17:01:20.2162415Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:01:20.2162552Z   }
2026-11-02T17:01:20.2163317Z   # Replace only the three pre-image-change production files in the
2026-11-02T17:01:20.2163566Z   # before snapshot; the same current harness runs in both copies.
2026-11-02T17:01:20.2163750Z   Set-Location "${drive}:\"
2026-11-02T17:01:20.2163877Z   foreach ($relative in @(
2026-11-02T17:01:20.2164036Z     'src/Flow.Launcher.Plugin.ClipboardPlus/Main.cs',
2026-11-02T17:01:20.2164302Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs',
2026-11-02T17:01:20.2164625Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T17:01:20.2164845Z   )) {
2026-11-02T17:01:20.2165049Z     git show "6a8203d:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:01:20.2165344Z     if ($LASTEXITCODE -ne 0) { throw "Image baseline source unavailable" }
2026-11-02T17:01:20.2165526Z   }
2026-11-02T17:01:20.2165642Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:01:20.2165802Z     Set-Location "$scratch\$variant"
2026-11-02T17:01:20.2166153Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-capture-only *> $diagnostic
2026-11-02T17:01:20.2166499Z     $exitCode = $LASTEXITCODE
2026-11-02T17:01:20.2166801Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image capture save 1024 noise: ms min/median/max=[0-9,./]+$' })
2026-11-02T17:01:20.2167237Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image capture A/B failed (details suppressed for privacy)" }
2026-11-02T17:01:20.2167518Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:01:20.2167653Z   }
2026-11-02T17:01:20.2167792Z   # Pinning baseline differs only in the record implementation.
2026-11-02T17:01:20.2167977Z   Set-Location "${drive}:\"
2026-11-02T17:01:20.2168251Z   git show 537ba8c:src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Clipboard/ClipboardData.cs 2>> $diagnostic |
2026-11-02T17:01:20.2168723Z     Set-Content -Encoding utf8 "$scratch\before\src\Flow.Launcher.Plugin.ClipboardPlus.Core\Data\Models\Clipboard\ClipboardData.cs"
2026-11-02T17:01:20.2169164Z   if ($LASTEXITCODE -ne 0) { throw "Pin baseline source unavailable" }
2026-11-02T17:01:20.2169401Z   # Restore the current image-capture implementation in the before
2026-11-02T17:01:20.2169616Z   # tree, so that only the hash-reuse change differs.
2026-11-02T17:01:20.2169780Z   foreach ($relative in @(
2026-11-02T17:01:20.2169896Z     
2026-11-02T17:01:20.2170090Z     'src/Flow.Launcher.Plugin.ClipboardPlus.Core/Data/Models/Database/SqliteDatabase.cs'
2026-11-02T17:01:20.2170309Z   )) {
2026-11-02T17:01:20.2170506Z     git show "HEAD:$relative" 2>> $diagnostic | Set-Content -Encoding utf8 "$scratch\before\$relative"
2026-11-02T17:01:20.2170782Z     if ($LASTEXITCODE -ne 0) { throw "Pin baseline source unavailable" }
2026-11-02T17:01:20.2170953Z   }
2026-11-02T17:01:20.2171064Z   foreach ($variant in @('before', 'after')) {
2026-11-02T17:01:20.2171226Z     Set-Location "$scratch\$variant"
2026-11-02T17:01:20.2171567Z     dotnet run --project tools/performance-baseline/PerformanceBaseline.csproj --configuration Release --no-restore -- --image-pin-only *> $diagnostic
2026-11-02T17:01:20.2171906Z     $exitCode = $LASTEXITCODE
2026-11-02T17:01:20.2172229Z     $measurement = @(Get-Content $diagnostic | Where-Object { $_ -match '^actual image pin 1024 noise: ms min/median/max=[0-9,./]+; median allocated=[0-9,.]+ MiB$' })
2026-11-02T17:01:20.2172933Z     if ($exitCode -ne 0 -or $measurement.Count -ne 1) { throw "Image pin A/B failed (details suppressed for privacy)" }
2026-11-02T17:01:20.2173211Z     Write-Host "$variant $($measurement[0])"
2026-11-02T17:01:20.2173352Z   }
2026-11-02T17:01:20.2173441Z } finally {
2026-11-02T17:01:20.2173546Z   Set-Location "${drive}:\"
2026-11-02T17:01:20.2173727Z   Remove-Item $scratch -Recurse -Force -ErrorAction SilentlyContinue
2026-11-02T17:01:20.2173924Z   Set-Location $env:RUNNER_TEMP
2026-11-02T17:01:20.2186343Z   Remove-Item $diagnostic -ErrorAction SilentlyContinue
2026-11-02T17:01:20.2186573Z   subst "${drive}:" /d
2026-11-02T17:01:20.2186692Z }
