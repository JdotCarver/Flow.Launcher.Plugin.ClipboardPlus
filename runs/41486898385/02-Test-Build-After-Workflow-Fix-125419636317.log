2026-11-02T17:00:31.7686861Z ##[group]Run # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:00:31.7687152Z # The tests live in dev/ and are not part of what a consumer
2026-11-02T17:00:31.7687376Z # repository copies, so their absence is expected there and is
2026-11-02T17:00:31.7687571Z # reported rather than treated as a failure.
2026-11-02T17:00:31.7687729Z $testDirectory = "dev/tests"
2026-11-02T17:00:31.7687876Z if (-not (Test-Path $testDirectory)) {
2026-11-02T17:00:31.7688125Z   Write-Host "No dev/tests directory; this repository ships the kit without its tests. Skipping."
2026-11-02T17:00:31.7688361Z   exit 0
2026-11-02T17:00:31.7688459Z }
2026-11-02T17:00:31.7688605Z # `unittest discover` exits 0 when it finds no tests at all, so a
2026-11-02T17:00:31.7688842Z # renamed test directory would report green having run nothing. Count
2026-11-02T17:00:31.7689075Z # them and fail below the expected floor instead.
2026-11-02T17:00:31.7689354Z & $env:PYTHON -m unittest discover -s $testDirectory -p "test_*.py" -v 2>&1 | Tee-Object -Variable testOutput
2026-11-02T17:00:31.7689629Z if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
2026-11-02T17:00:31.7689848Z $summary = ($testOutput | Select-String -Pattern '^Ran (\d+) tests').Matches
2026-11-02T17:00:31.7690093Z if (-not $summary -or [int]$summary.Groups[1].Value -lt 20) {
2026-11-02T17:00:31.7690328Z   throw "Expected at least 20 tests to run; discovery found none or too few."
2026-11-02T17:00:31.7690518Z }
